      <rule id="rule_fund_ppp_primary"><description>PPP vehicle: primary</description><inputEntry id="rfund_ppp_p_0"><text>"ppp"</text></inputEntry><inputEntry id="rfund_ppp_p_1"><text>-</text></inputEntry><inputEntry id="rfund_ppp_p_2"><text>-</text></inputEntry><inputEntry id="rfund_ppp_p_3"><text>-</text></inputEntry><inputEntry id="rfund_ppp_p_4"><text>-</text></inputEntry><outputEntry id="oe_fund_ppp_p"><text>4</text></outputEntry></rule>
