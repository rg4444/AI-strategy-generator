  </decision>
  <decision id="score_decomp" name="Axis score: Decomposition">
    <description>How concentrated the structure is. Enablers only or sectors only 3; matrix 4; missions 5.</description>
    <informationRequirement id="ir_decomp_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_decomp_enab"><requiredInput href="#in_partial_decomp_enab"/></informationRequirement>
    <informationRequirement id="ir_decomp_sect"><requiredInput href="#in_partial_decomp_sect"/></informationRequirement>
