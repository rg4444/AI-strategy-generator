      <rule id="rule_meas_none_partial"><description>none: partial</description><inputEntry id="rmeas_none_s_0"><text>-</text></inputEntry><inputEntry id="rmeas_none_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="rmeas_none_s_2"><text>-</text></inputEntry><inputEntry id="rmeas_none_s_3"><text>-</text></inputEntry><inputEntry id="rmeas_none_s_4"><text>-</text></inputEntry><outputEntry id="oe_meas_none_s"><text>0 * partial_meas_none / 5</text></outputEntry></rule>
      <rule id="rule_meas_act_primary"><description>activity KPIs: primary</description><inputEntry id="rmeas_act_p_0"><text>"act"</text></inputEntry><inputEntry id="rmeas_act_p_1"><text>-</text></inputEntry><inputEntry id="rmeas_act_p_2"><text>-</text></inputEntry><inputEntry id="rmeas_act_p_3"><text>-</text></inputEntry><inputEntry id="rmeas_act_p_4"><text>-</text></inputEntry><outputEntry id="oe_meas_act_p"><text>2</text></outputEntry></rule>
      <rule id="rule_meas_act_partial"><description>activity KPIs: partial</description><inputEntry id="rmeas_act_s_0"><text>-</text></inputEntry><inputEntry id="rmeas_act_s_1"><text>-</text></inputEntry><inputEntry id="rmeas_act_s_2"><text>&gt; 0</text></inputEntry><inputEntry id="rmeas_act_s_3"><text>-</text></inputEntry><inputEntry id="rmeas_act_s_4"><text>-</text></inputEntry><outputEntry id="oe_meas_act_s"><text>2 * partial_meas_act / 5</text></outputEntry></rule>
