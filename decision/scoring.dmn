      <rule id="rule_interest_comp_primary"><description>competitiveness: primary</description><inputEntry id="rinterest_comp_p_0"><text>"comp"</text></inputEntry><inputEntry id="rinterest_comp_p_1"><text>-</text></inputEntry><inputEntry id="rinterest_comp_p_2"><text>-</text></inputEntry><inputEntry id="rinterest_comp_p_3"><text>-</text></inputEntry><inputEntry id="rinterest_comp_p_4"><text>-</text></inputEntry><inputEntry id="rinterest_comp_p_5"><text>-</text></inputEntry><inputEntry id="rinterest_comp_p_6"><text>-</text></inputEntry><inputEntry id="rinterest_comp_p_7"><text>-</text></inputEntry><inputEntry id="rinterest_comp_p_8"><text>-</text></inputEntry><inputEntry id="rinterest_comp_p_9"><text>-</text></inputEntry><outputEntry id="oe_interest_comp_p"><text>2</text></outputEntry></rule>
