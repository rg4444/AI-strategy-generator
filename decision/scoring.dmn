      <rule id="rule_compute_euro_primary"><description>EuroHPC antenna: primary</description><inputEntry id="rcompute_euro_p_0"><text>"euro"</text></inputEntry><inputEntry id="rcompute_euro_p_1"><text>-</text></inputEntry><inputEntry id="rcompute_euro_p_2"><text>-</text></inputEntry><inputEntry id="rcompute_euro_p_3"><text>-</text></inputEntry><inputEntry id="rcompute_euro_p_4"><text>-</text></inputEntry><inputEntry id="rcompute_euro_p_5"><text>-</text></inputEntry><outputEntry id="oe_compute_euro_p"><text>3</text></outputEntry></rule>
