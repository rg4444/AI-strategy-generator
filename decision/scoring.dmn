      <rule id="rule_fund_undecided"><description>undecided / no partials</description><inputEntry id="rfund_none_0"><text>-</text></inputEntry><inputEntry id="rfund_none_1"><text>-</text></inputEntry><inputEntry id="rfund_none_2"><text>-</text></inputEntry><inputEntry id="rfund_none_3"><text>-</text></inputEntry><inputEntry id="rfund_none_4"><text>-</text></inputEntry><outputEntry id="oe_fund_none"><text>0</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="score_sourcing" name="Axis score: Model sourcing">
    <description>How decidedly the document says where models come from. Decentralised by default 1; bloc co-funding 3; broker or self-hosting 4; national model 5. Measures decidedness, not feasibility.</description>
    <informationRequirement id="ir_sourcing_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_sourcing_dec"><requiredInput href="#in_partial_sourcing_dec"/></informationRequirement>
    <informationRequirement id="ir_sourcing_brok"><requiredInput href="#in_partial_sourcing_brok"/></informationRequirement>
    <informationRequirement id="ir_sourcing_self"><requiredInput href="#in_partial_sourcing_self"/></informationRequirement>
    <informationRequirement id="ir_sourcing_natl"><requiredInput href="#in_partial_sourcing_natl"/></informationRequirement>
    <informationRequirement id="ir_sourcing_hybrid"><requiredInput href="#in_partial_sourcing_hybrid"/></informationRequirement>
    <informationRequirement id="ir_sourcing_bloc"><requiredInput href="#in_partial_sourcing_bloc"/></informationRequirement>
    <decisionTable id="dt_sourcing" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_sourcing_primary" label="primary option (coding.sourcing)"><inputExpression id="ie_sourcing_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_sourcing_dec" label="partial score for dec (0-5)"><inputExpression id="ie_sourcing_dec" typeRef="number"><text>partial_sourcing_dec</text></inputExpression></input>
      <input id="i_sourcing_brok" label="partial score for brok (0-5)"><inputExpression id="ie_sourcing_brok" typeRef="number"><text>partial_sourcing_brok</text></inputExpression></input>
      <input id="i_sourcing_self" label="partial score for self (0-5)"><inputExpression id="ie_sourcing_self" typeRef="number"><text>partial_sourcing_self</text></inputExpression></input>
      <input id="i_sourcing_natl" label="partial score for natl (0-5)"><inputExpression id="ie_sourcing_natl" typeRef="number"><text>partial_sourcing_natl</text></inputExpression></input>
      <input id="i_sourcing_hybrid" label="partial score for hybrid (0-5)"><inputExpression id="ie_sourcing_hybrid" typeRef="number"><text>partial_sourcing_hybrid</text></inputExpression></input>
      <input id="i_sourcing_bloc" label="partial score for bloc (0-5)"><inputExpression id="ie_sourcing_bloc" typeRef="number"><text>partial_sourcing_bloc</text></inputExpression></input>
      <output id="o_sourcing" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_sourcing_dec_primary"><description>decentralised procurement: primary</description><inputEntry id="rsourcing_dec_p_0"><text>"dec"</text></inputEntry><inputEntry id="rsourcing_dec_p_1"><text>-</text></inputEntry><inputEntry id="rsourcing_dec_p_2"><text>-</text></inputEntry><inputEntry id="rsourcing_dec_p_3"><text>-</text></inputEntry><inputEntry id="rsourcing_dec_p_4"><text>-</text></inputEntry><inputEntry id="rsourcing_dec_p_5"><text>-</text></inputEntry><inputEntry id="rsourcing_dec_p_6"><text>-</text></inputEntry><outputEntry id="oe_sourcing_dec_p"><text>1</text></outputEntry></rule>
      <rule id="rule_sourcing_dec_partial"><description>decentralised procurement: partial</description><inputEntry id="rsourcing_dec_s_0"><text>-</text></inputEntry><inputEntry id="rsourcing_dec_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="rsourcing_dec_s_2"><text>-</text></inputEntry><inputEntry id="rsourcing_dec_s_3"><text>-</text></inputEntry><inputEntry id="rsourcing_dec_s_4"><text>-</text></inputEntry><inputEntry id="rsourcing_dec_s_5"><text>-</text></inputEntry><inputEntry id="rsourcing_dec_s_6"><text>-</text></inputEntry><outputEntry id="oe_sourcing_dec_s"><text>1 * partial_sourcing_dec / 5</text></outputEntry></rule>
      <rule id="rule_sourcing_brok_primary"><description>central broker: primary</description><inputEntry id="rsourcing_brok_p_0"><text>"brok"</text></inputEntry><inputEntry id="rsourcing_brok_p_1"><text>-</text></inputEntry><inputEntry id="rsourcing_brok_p_2"><text>-</text></inputEntry><inputEntry id="rsourcing_brok_p_3"><text>-</text></inputEntry><inputEntry id="rsourcing_brok_p_4"><text>-</text></inputEntry><inputEntry id="rsourcing_brok_p_5"><text>-</text></inputEntry><inputEntry id="rsourcing_brok_p_6"><text>-</text></inputEntry><outputEntry id="oe_sourcing_brok_p"><text>4</text></outputEntry></rule>
      <rule id="rule_sourcing_brok_partial"><description>central broker: partial</description><inputEntry id="rsourcing_brok_s_0"><text>-</text></inputEntry><inputEntry id="rsourcing_brok_s_1"><text>-</text></inputEntry><inputEntry id="rsourcing_brok_s_2"><text>&gt; 0</text></inputEntry><inputEntry id="rsourcing_brok_s_3"><text>-</text></inputEntry><inputEntry id="rsourcing_brok_s_4"><text>-</text></inputEntry><inputEntry id="rsourcing_brok_s_5"><text>-</text></inputEntry><inputEntry id="rsourcing_brok_s_6"><text>-</text></inputEntry><outputEntry id="oe_sourcing_brok_s"><text>4 * partial_sourcing_brok / 5</text></outputEntry></rule>
      <rule id="rule_sourcing_self_primary"><description>self-hosted open-weight: primary</description><inputEntry id="rsourcing_self_p_0"><text>"self"</text></inputEntry><inputEntry id="rsourcing_self_p_1"><text>-</text></inputEntry><inputEntry id="rsourcing_self_p_2"><text>-</text></inputEntry><inputEntry id="rsourcing_self_p_3"><text>-</text></inputEntry><inputEntry id="rsourcing_self_p_4"><text>-</text></inputEntry><inputEntry id="rsourcing_self_p_5"><text>-</text></inputEntry><inputEntry id="rsourcing_self_p_6"><text>-</text></inputEntry><outputEntry id="oe_sourcing_self_p"><text>4</text></outputEntry></rule>
      <rule id="rule_sourcing_self_partial"><description>self-hosted open-weight: partial</description><inputEntry id="rsourcing_self_s_0"><text>-</text></inputEntry><inputEntry id="rsourcing_self_s_1"><text>-</text></inputEntry><inputEntry id="rsourcing_self_s_2"><text>-</text></inputEntry><inputEntry id="rsourcing_self_s_3"><text>&gt; 0</text></inputEntry><inputEntry id="rsourcing_self_s_4"><text>-</text></inputEntry><inputEntry id="rsourcing_self_s_5"><text>-</text></inputEntry><inputEntry id="rsourcing_self_s_6"><text>-</text></inputEntry><outputEntry id="oe_sourcing_self_s"><text>4 * partial_sourcing_self / 5</text></outputEntry></rule>
      <rule id="rule_sourcing_natl_primary"><description>national frontier model: primary</description><inputEntry id="rsourcing_natl_p_0"><text>"natl"</text></inputEntry><inputEntry id="rsourcing_natl_p_1"><text>-</text></inputEntry><inputEntry id="rsourcing_natl_p_2"><text>-</text></inputEntry><inputEntry id="rsourcing_natl_p_3"><text>-</text></inputEntry><inputEntry id="rsourcing_natl_p_4"><text>-</text></inputEntry><inputEntry id="rsourcing_natl_p_5"><text>-</text></inputEntry><inputEntry id="rsourcing_natl_p_6"><text>-</text></inputEntry><outputEntry id="oe_sourcing_natl_p"><text>5</text></outputEntry></rule>
      <rule id="rule_sourcing_natl_partial"><description>national frontier model: partial</description><inputEntry id="rsourcing_natl_s_0"><text>-</text></inputEntry><inputEntry id="rsourcing_natl_s_1"><text>-</text></inputEntry><inputEntry id="rsourcing_natl_s_2"><text>-</text></inputEntry><inputEntry id="rsourcing_natl_s_3"><text>-</text></inputEntry><inputEntry id="rsourcing_natl_s_4"><text>&gt; 0</text></inputEntry><inputEntry id="rsourcing_natl_s_5"><text>-</text></inputEntry><inputEntry id="rsourcing_natl_s_6"><text>-</text></inputEntry><outputEntry id="oe_sourcing_natl_s"><text>5 * partial_sourcing_natl / 5</text></outputEntry></rule>
      <rule id="rule_sourcing_hybrid_primary"><description>hybrid: external models + own fallback: primary</description><inputEntry id="rsourcing_hybrid_p_0"><text>"hybrid"</text></inputEntry><inputEntry id="rsourcing_hybrid_p_1"><text>-</text></inputEntry><inputEntry id="rsourcing_hybrid_p_2"><text>-</text></inputEntry><inputEntry id="rsourcing_hybrid_p_3"><text>-</text></inputEntry><inputEntry id="rsourcing_hybrid_p_4"><text>-</text></inputEntry><inputEntry id="rsourcing_hybrid_p_5"><text>-</text></inputEntry><inputEntry id="rsourcing_hybrid_p_6"><text>-</text></inputEntry><outputEntry id="oe_sourcing_hybrid_p"><text>5</text></outputEntry></rule>
      <rule id="rule_sourcing_hybrid_partial"><description>hybrid: external models + own fallback: partial</description><inputEntry id="rsourcing_hybrid_s_0"><text>-</text></inputEntry><inputEntry id="rsourcing_hybrid_s_1"><text>-</text></inputEntry><inputEntry id="rsourcing_hybrid_s_2"><text>-</text></inputEntry><inputEntry id="rsourcing_hybrid_s_3"><text>-</text></inputEntry><inputEntry id="rsourcing_hybrid_s_4"><text>-</text></inputEntry><inputEntry id="rsourcing_hybrid_s_5"><text>&gt; 0</text></inputEntry><inputEntry id="rsourcing_hybrid_s_6"><text>-</text></inputEntry><outputEntry id="oe_sourcing_hybrid_s"><text>5 * partial_sourcing_hybrid / 5</text></outputEntry></rule>
      <rule id="rule_sourcing_bloc_primary"><description>bloc co-funding: primary</description><inputEntry id="rsourcing_bloc_p_0"><text>"bloc"</text></inputEntry><inputEntry id="rsourcing_bloc_p_1"><text>-</text></inputEntry><inputEntry id="rsourcing_bloc_p_2"><text>-</text></inputEntry><inputEntry id="rsourcing_bloc_p_3"><text>-</text></inputEntry><inputEntry id="rsourcing_bloc_p_4"><text>-</text></inputEntry><inputEntry id="rsourcing_bloc_p_5"><text>-</text></inputEntry><inputEntry id="rsourcing_bloc_p_6"><text>-</text></inputEntry><outputEntry id="oe_sourcing_bloc_p"><text>3</text></outputEntry></rule>
      <rule id="rule_sourcing_bloc_partial"><description>bloc co-funding: partial</description><inputEntry id="rsourcing_bloc_s_0"><text>-</text></inputEntry><inputEntry id="rsourcing_bloc_s_1"><text>-</text></inputEntry><inputEntry id="rsourcing_bloc_s_2"><text>-</text></inputEntry><inputEntry id="rsourcing_bloc_s_3"><text>-</text></inputEntry><inputEntry id="rsourcing_bloc_s_4"><text>-</text></inputEntry><inputEntry id="rsourcing_bloc_s_5"><text>-</text></inputEntry><inputEntry id="rsourcing_bloc_s_6"><text>&gt; 0</text></inputEntry><outputEntry id="oe_sourcing_bloc_s"><text>3 * partial_sourcing_bloc / 5</text></outputEntry></rule>
      <rule id="rule_sourcing_undecided"><description>undecided / no partials</description><inputEntry id="rsourcing_none_0"><text>-</text></inputEntry><inputEntry id="rsourcing_none_1"><text>-</text></inputEntry><inputEntry id="rsourcing_none_2"><text>-</text></inputEntry><inputEntry id="rsourcing_none_3"><text>-</text></inputEntry><inputEntry id="rsourcing_none_4"><text>-</text></inputEntry><inputEntry id="rsourcing_none_5"><text>-</text></inputEntry><inputEntry id="rsourcing_none_6"><text>-</text></inputEntry><outputEntry id="oe_sourcing_none"><text>0</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="score_compute" name="Axis score: Compute">
    <description>What compute is secured. None 0; commercial cloud only 1; EuroHPC antenna 3; sovereign PPP 4; own national HPC 5.</description>
    <informationRequirement id="ir_compute_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_compute_none"><requiredInput href="#in_partial_compute_none"/></informationRequirement>
    <informationRequirement id="ir_compute_nat"><requiredInput href="#in_partial_compute_nat"/></informationRequirement>
    <informationRequirement id="ir_compute_euro"><requiredInput href="#in_partial_compute_euro"/></informationRequirement>
    <informationRequirement id="ir_compute_ppp"><requiredInput href="#in_partial_compute_ppp"/></informationRequirement>
    <informationRequirement id="ir_compute_cloud"><requiredInput href="#in_partial_compute_cloud"/></informationRequirement>
    <decisionTable id="dt_compute" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_compute_primary" label="primary option (coding.compute)"><inputExpression id="ie_compute_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_compute_none" label="partial score for none (0-5)"><inputExpression id="ie_compute_none" typeRef="number"><text>partial_compute_none</text></inputExpression></input>
      <input id="i_compute_nat" label="partial score for nat (0-5)"><inputExpression id="ie_compute_nat" typeRef="number"><text>partial_compute_nat</text></inputExpression></input>
      <input id="i_compute_euro" label="partial score for euro (0-5)"><inputExpression id="ie_compute_euro" typeRef="number"><text>partial_compute_euro</text></inputExpression></input>
      <input id="i_compute_ppp" label="partial score for ppp (0-5)"><inputExpression id="ie_compute_ppp" typeRef="number"><text>partial_compute_ppp</text></inputExpression></input>
      <input id="i_compute_cloud" label="partial score for cloud (0-5)"><inputExpression id="ie_compute_cloud" typeRef="number"><text>partial_compute_cloud</text></inputExpression></input>
      <output id="o_compute" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_compute_none_primary"><description>none: primary</description><inputEntry id="rcompute_none_p_0"><text>"none"</text></inputEntry><inputEntry id="rcompute_none_p_1"><text>-</text></inputEntry><inputEntry id="rcompute_none_p_2"><text>-</text></inputEntry><inputEntry id="rcompute_none_p_3"><text>-</text></inputEntry><inputEntry id="rcompute_none_p_4"><text>-</text></inputEntry><inputEntry id="rcompute_none_p_5"><text>-</text></inputEntry><outputEntry id="oe_compute_none_p"><text>0</text></outputEntry></rule>
      <rule id="rule_compute_none_partial"><description>none: partial</description><inputEntry id="rcompute_none_s_0"><text>-</text></inputEntry><inputEntry id="rcompute_none_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="rcompute_none_s_2"><text>-</text></inputEntry><inputEntry id="rcompute_none_s_3"><text>-</text></inputEntry><inputEntry id="rcompute_none_s_4"><text>-</text></inputEntry><inputEntry id="rcompute_none_s_5"><text>-</text></inputEntry><outputEntry id="oe_compute_none_s"><text>0 * partial_compute_none / 5</text></outputEntry></rule>
      <rule id="rule_compute_nat_primary"><description>national HPC: primary</description><inputEntry id="rcompute_nat_p_0"><text>"nat"</text></inputEntry><inputEntry id="rcompute_nat_p_1"><text>-</text></inputEntry><inputEntry id="rcompute_nat_p_2"><text>-</text></inputEntry><inputEntry id="rcompute_nat_p_3"><text>-</text></inputEntry><inputEntry id="rcompute_nat_p_4"><text>-</text></inputEntry><inputEntry id="rcompute_nat_p_5"><text>-</text></inputEntry><outputEntry id="oe_compute_nat_p"><text>5</text></outputEntry></rule>
