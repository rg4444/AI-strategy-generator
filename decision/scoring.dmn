  </decision>
  <decision id="score_knowledge" name="Axis score: Knowledge accumulation">
    <description>Whether the state accumulates and reuses what institutions know and learn, instead of starting from zero each time. None 0; document digitisation 1; machine-readable records and a data catalogue 2; reusable shared components 3; organisational knowledge base 4; federated knowledge exchange between institutions 5. Distinct from “Evaluation &amp; memory”: that axis is what worked, this one is the corpus itself.</description>
    <informationRequirement id="ir_knowledge_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_knowledge_none"><requiredInput href="#in_partial_knowledge_none"/></informationRequirement>
    <informationRequirement id="ir_knowledge_docs"><requiredInput href="#in_partial_knowledge_docs"/></informationRequirement>
    <informationRequirement id="ir_knowledge_mrec"><requiredInput href="#in_partial_knowledge_mrec"/></informationRequirement>
    <informationRequirement id="ir_knowledge_reuse"><requiredInput href="#in_partial_knowledge_reuse"/></informationRequirement>
    <informationRequirement id="ir_knowledge_orgkb"><requiredInput href="#in_partial_knowledge_orgkb"/></informationRequirement>
    <informationRequirement id="ir_knowledge_fed"><requiredInput href="#in_partial_knowledge_fed"/></informationRequirement>
    <decisionTable id="dt_knowledge" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_knowledge_primary" label="primary option (coding.knowledge)"><inputExpression id="ie_knowledge_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_knowledge_none" label="partial score for none (0-5)"><inputExpression id="ie_knowledge_none" typeRef="number"><text>partial_knowledge_none</text></inputExpression></input>
      <input id="i_knowledge_docs" label="partial score for docs (0-5)"><inputExpression id="ie_knowledge_docs" typeRef="number"><text>partial_knowledge_docs</text></inputExpression></input>
      <input id="i_knowledge_mrec" label="partial score for mrec (0-5)"><inputExpression id="ie_knowledge_mrec" typeRef="number"><text>partial_knowledge_mrec</text></inputExpression></input>
      <input id="i_knowledge_reuse" label="partial score for reuse (0-5)"><inputExpression id="ie_knowledge_reuse" typeRef="number"><text>partial_knowledge_reuse</text></inputExpression></input>
      <input id="i_knowledge_orgkb" label="partial score for orgkb (0-5)"><inputExpression id="ie_knowledge_orgkb" typeRef="number"><text>partial_knowledge_orgkb</text></inputExpression></input>
      <input id="i_knowledge_fed" label="partial score for fed (0-5)"><inputExpression id="ie_knowledge_fed" typeRef="number"><text>partial_knowledge_fed</text></inputExpression></input>
      <output id="o_knowledge" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_knowledge_none_primary"><description>none: primary</description><inputEntry id="rknowledge_none_p_0"><text>"none"</text></inputEntry><inputEntry id="rknowledge_none_p_1"><text>-</text></inputEntry><inputEntry id="rknowledge_none_p_2"><text>-</text></inputEntry><inputEntry id="rknowledge_none_p_3"><text>-</text></inputEntry><inputEntry id="rknowledge_none_p_4"><text>-</text></inputEntry><inputEntry id="rknowledge_none_p_5"><text>-</text></inputEntry><inputEntry id="rknowledge_none_p_6"><text>-</text></inputEntry><outputEntry id="oe_knowledge_none_p"><text>0</text></outputEntry></rule>
      <rule id="rule_knowledge_none_partial"><description>none: partial</description><inputEntry id="rknowledge_none_s_0"><text>-</text></inputEntry><inputEntry id="rknowledge_none_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="rknowledge_none_s_2"><text>-</text></inputEntry><inputEntry id="rknowledge_none_s_3"><text>-</text></inputEntry><inputEntry id="rknowledge_none_s_4"><text>-</text></inputEntry><inputEntry id="rknowledge_none_s_5"><text>-</text></inputEntry><inputEntry id="rknowledge_none_s_6"><text>-</text></inputEntry><outputEntry id="oe_knowledge_none_s"><text>0 * partial_knowledge_none / 5</text></outputEntry></rule>
      <rule id="rule_knowledge_docs_primary"><description>document digitisation: primary</description><inputEntry id="rknowledge_docs_p_0"><text>"docs"</text></inputEntry><inputEntry id="rknowledge_docs_p_1"><text>-</text></inputEntry><inputEntry id="rknowledge_docs_p_2"><text>-</text></inputEntry><inputEntry id="rknowledge_docs_p_3"><text>-</text></inputEntry><inputEntry id="rknowledge_docs_p_4"><text>-</text></inputEntry><inputEntry id="rknowledge_docs_p_5"><text>-</text></inputEntry><inputEntry id="rknowledge_docs_p_6"><text>-</text></inputEntry><outputEntry id="oe_knowledge_docs_p"><text>1</text></outputEntry></rule>
      <rule id="rule_knowledge_docs_partial"><description>document digitisation: partial</description><inputEntry id="rknowledge_docs_s_0"><text>-</text></inputEntry><inputEntry id="rknowledge_docs_s_1"><text>-</text></inputEntry><inputEntry id="rknowledge_docs_s_2"><text>&gt; 0</text></inputEntry><inputEntry id="rknowledge_docs_s_3"><text>-</text></inputEntry><inputEntry id="rknowledge_docs_s_4"><text>-</text></inputEntry><inputEntry id="rknowledge_docs_s_5"><text>-</text></inputEntry><inputEntry id="rknowledge_docs_s_6"><text>-</text></inputEntry><outputEntry id="oe_knowledge_docs_s"><text>1 * partial_knowledge_docs / 5</text></outputEntry></rule>
      <rule id="rule_knowledge_mrec_primary"><description>machine-readable records and data catalogue: primary</description><inputEntry id="rknowledge_mrec_p_0"><text>"mrec"</text></inputEntry><inputEntry id="rknowledge_mrec_p_1"><text>-</text></inputEntry><inputEntry id="rknowledge_mrec_p_2"><text>-</text></inputEntry><inputEntry id="rknowledge_mrec_p_3"><text>-</text></inputEntry><inputEntry id="rknowledge_mrec_p_4"><text>-</text></inputEntry><inputEntry id="rknowledge_mrec_p_5"><text>-</text></inputEntry><inputEntry id="rknowledge_mrec_p_6"><text>-</text></inputEntry><outputEntry id="oe_knowledge_mrec_p"><text>2</text></outputEntry></rule>
