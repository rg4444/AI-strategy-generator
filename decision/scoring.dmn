      <rule id="rule_knowledge_reuse_primary"><description>reusable shared components: primary</description><inputEntry id="rknowledge_reuse_p_0"><text>"reuse"</text></inputEntry><inputEntry id="rknowledge_reuse_p_1"><text>-</text></inputEntry><inputEntry id="rknowledge_reuse_p_2"><text>-</text></inputEntry><inputEntry id="rknowledge_reuse_p_3"><text>-</text></inputEntry><inputEntry id="rknowledge_reuse_p_4"><text>-</text></inputEntry><inputEntry id="rknowledge_reuse_p_5"><text>-</text></inputEntry><inputEntry id="rknowledge_reuse_p_6"><text>-</text></inputEntry><outputEntry id="oe_knowledge_reuse_p"><text>3</text></outputEntry></rule>
      <rule id="rule_knowledge_reuse_partial"><description>reusable shared components: partial</description><inputEntry id="rknowledge_reuse_s_0"><text>-</text></inputEntry><inputEntry id="rknowledge_reuse_s_1"><text>-</text></inputEntry><inputEntry id="rknowledge_reuse_s_2"><text>-</text></inputEntry><inputEntry id="rknowledge_reuse_s_3"><text>-</text></inputEntry><inputEntry id="rknowledge_reuse_s_4"><text>&gt; 0</text></inputEntry><inputEntry id="rknowledge_reuse_s_5"><text>-</text></inputEntry><inputEntry id="rknowledge_reuse_s_6"><text>-</text></inputEntry><outputEntry id="oe_knowledge_reuse_s"><text>3 * partial_knowledge_reuse / 5</text></outputEntry></rule>
