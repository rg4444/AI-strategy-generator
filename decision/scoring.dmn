      <rule id="rule_eval_undecided"><description>undecided / no partials</description><inputEntry id="reval_none_0"><text>-</text></inputEntry><inputEntry id="reval_none_1"><text>-</text></inputEntry><inputEntry id="reval_none_2"><text>-</text></inputEntry><inputEntry id="reval_none_3"><text>-</text></inputEntry><inputEntry id="reval_none_4"><text>-</text></inputEntry><outputEntry id="oe_eval_none"><text>0</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="score_return" name="Axis score: How return is evaluated">
    <description>Whether the strategy says how and when to measure the return on AI investment. None 0; one measure (ROI) for everything 2; operational return at 90 days (ROAI) 3; price before signature (EVC) 3; three instruments by horizon — EVC before signature, ROAI at 90 days, ROI at 12 months — 5. Higher means a clearer method, not a larger return. Below the axis: the three questions that pick the instrument.</description>
    <informationRequirement id="ir_return_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_return_none"><requiredInput href="#in_partial_return_none"/></informationRequirement>
    <informationRequirement id="ir_return_roi"><requiredInput href="#in_partial_return_roi"/></informationRequirement>
    <informationRequirement id="ir_return_roai"><requiredInput href="#in_partial_return_roai"/></informationRequirement>
    <informationRequirement id="ir_return_evc"><requiredInput href="#in_partial_return_evc"/></informationRequirement>
    <informationRequirement id="ir_return_layered"><requiredInput href="#in_partial_return_layered"/></informationRequirement>
    <decisionTable id="dt_return" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_return_primary" label="primary option (coding.return)"><inputExpression id="ie_return_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_return_none" label="partial score for none (0-5)"><inputExpression id="ie_return_none" typeRef="number"><text>partial_return_none</text></inputExpression></input>
      <input id="i_return_roi" label="partial score for roi (0-5)"><inputExpression id="ie_return_roi" typeRef="number"><text>partial_return_roi</text></inputExpression></input>
      <input id="i_return_roai" label="partial score for roai (0-5)"><inputExpression id="ie_return_roai" typeRef="number"><text>partial_return_roai</text></inputExpression></input>
      <input id="i_return_evc" label="partial score for evc (0-5)"><inputExpression id="ie_return_evc" typeRef="number"><text>partial_return_evc</text></inputExpression></input>
      <input id="i_return_layered" label="partial score for layered (0-5)"><inputExpression id="ie_return_layered" typeRef="number"><text>partial_return_layered</text></inputExpression></input>
      <output id="o_return" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_return_none_primary"><description>none stated: primary</description><inputEntry id="rreturn_none_p_0"><text>"none"</text></inputEntry><inputEntry id="rreturn_none_p_1"><text>-</text></inputEntry><inputEntry id="rreturn_none_p_2"><text>-</text></inputEntry><inputEntry id="rreturn_none_p_3"><text>-</text></inputEntry><inputEntry id="rreturn_none_p_4"><text>-</text></inputEntry><inputEntry id="rreturn_none_p_5"><text>-</text></inputEntry><outputEntry id="oe_return_none_p"><text>0</text></outputEntry></rule>
      <rule id="rule_return_none_partial"><description>none stated: partial</description><inputEntry id="rreturn_none_s_0"><text>-</text></inputEntry><inputEntry id="rreturn_none_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="rreturn_none_s_2"><text>-</text></inputEntry><inputEntry id="rreturn_none_s_3"><text>-</text></inputEntry><inputEntry id="rreturn_none_s_4"><text>-</text></inputEntry><inputEntry id="rreturn_none_s_5"><text>-</text></inputEntry><outputEntry id="oe_return_none_s"><text>0 * partial_return_none / 5</text></outputEntry></rule>
      <rule id="rule_return_roi_primary"><description>single measure — ROI: primary</description><inputEntry id="rreturn_roi_p_0"><text>"roi"</text></inputEntry><inputEntry id="rreturn_roi_p_1"><text>-</text></inputEntry><inputEntry id="rreturn_roi_p_2"><text>-</text></inputEntry><inputEntry id="rreturn_roi_p_3"><text>-</text></inputEntry><inputEntry id="rreturn_roi_p_4"><text>-</text></inputEntry><inputEntry id="rreturn_roi_p_5"><text>-</text></inputEntry><outputEntry id="oe_return_roi_p"><text>2</text></outputEntry></rule>
      <rule id="rule_return_roi_partial"><description>single measure — ROI: partial</description><inputEntry id="rreturn_roi_s_0"><text>-</text></inputEntry><inputEntry id="rreturn_roi_s_1"><text>-</text></inputEntry><inputEntry id="rreturn_roi_s_2"><text>&gt; 0</text></inputEntry><inputEntry id="rreturn_roi_s_3"><text>-</text></inputEntry><inputEntry id="rreturn_roi_s_4"><text>-</text></inputEntry><inputEntry id="rreturn_roi_s_5"><text>-</text></inputEntry><outputEntry id="oe_return_roi_s"><text>2 * partial_return_roi / 5</text></outputEntry></rule>
      <rule id="rule_return_roai_primary"><description>operational return at 90 days (ROAI): primary</description><inputEntry id="rreturn_roai_p_0"><text>"roai"</text></inputEntry><inputEntry id="rreturn_roai_p_1"><text>-</text></inputEntry><inputEntry id="rreturn_roai_p_2"><text>-</text></inputEntry><inputEntry id="rreturn_roai_p_3"><text>-</text></inputEntry><inputEntry id="rreturn_roai_p_4"><text>-</text></inputEntry><inputEntry id="rreturn_roai_p_5"><text>-</text></inputEntry><outputEntry id="oe_return_roai_p"><text>3</text></outputEntry></rule>
      <rule id="rule_return_roai_partial"><description>operational return at 90 days (ROAI): partial</description><inputEntry id="rreturn_roai_s_0"><text>-</text></inputEntry><inputEntry id="rreturn_roai_s_1"><text>-</text></inputEntry><inputEntry id="rreturn_roai_s_2"><text>-</text></inputEntry><inputEntry id="rreturn_roai_s_3"><text>&gt; 0</text></inputEntry><inputEntry id="rreturn_roai_s_4"><text>-</text></inputEntry><inputEntry id="rreturn_roai_s_5"><text>-</text></inputEntry><outputEntry id="oe_return_roai_s"><text>3 * partial_return_roai / 5</text></outputEntry></rule>
      <rule id="rule_return_evc_primary"><description>price before signature (EVC): primary</description><inputEntry id="rreturn_evc_p_0"><text>"evc"</text></inputEntry><inputEntry id="rreturn_evc_p_1"><text>-</text></inputEntry><inputEntry id="rreturn_evc_p_2"><text>-</text></inputEntry><inputEntry id="rreturn_evc_p_3"><text>-</text></inputEntry><inputEntry id="rreturn_evc_p_4"><text>-</text></inputEntry><inputEntry id="rreturn_evc_p_5"><text>-</text></inputEntry><outputEntry id="oe_return_evc_p"><text>3</text></outputEntry></rule>
      <rule id="rule_return_evc_partial"><description>price before signature (EVC): partial</description><inputEntry id="rreturn_evc_s_0"><text>-</text></inputEntry><inputEntry id="rreturn_evc_s_1"><text>-</text></inputEntry><inputEntry id="rreturn_evc_s_2"><text>-</text></inputEntry><inputEntry id="rreturn_evc_s_3"><text>-</text></inputEntry><inputEntry id="rreturn_evc_s_4"><text>&gt; 0</text></inputEntry><inputEntry id="rreturn_evc_s_5"><text>-</text></inputEntry><outputEntry id="oe_return_evc_s"><text>3 * partial_return_evc / 5</text></outputEntry></rule>
      <rule id="rule_return_layered_primary"><description>three instruments by horizon: EVC → ROAI → ROI: primary</description><inputEntry id="rreturn_layered_p_0"><text>"layered"</text></inputEntry><inputEntry id="rreturn_layered_p_1"><text>-</text></inputEntry><inputEntry id="rreturn_layered_p_2"><text>-</text></inputEntry><inputEntry id="rreturn_layered_p_3"><text>-</text></inputEntry><inputEntry id="rreturn_layered_p_4"><text>-</text></inputEntry><inputEntry id="rreturn_layered_p_5"><text>-</text></inputEntry><outputEntry id="oe_return_layered_p"><text>5</text></outputEntry></rule>
      <rule id="rule_return_layered_partial"><description>three instruments by horizon: EVC → ROAI → ROI: partial</description><inputEntry id="rreturn_layered_s_0"><text>-</text></inputEntry><inputEntry id="rreturn_layered_s_1"><text>-</text></inputEntry><inputEntry id="rreturn_layered_s_2"><text>-</text></inputEntry><inputEntry id="rreturn_layered_s_3"><text>-</text></inputEntry><inputEntry id="rreturn_layered_s_4"><text>-</text></inputEntry><inputEntry id="rreturn_layered_s_5"><text>&gt; 0</text></inputEntry><outputEntry id="oe_return_layered_s"><text>5 * partial_return_layered / 5</text></outputEntry></rule>
      <rule id="rule_return_undecided"><description>undecided / no partials</description><inputEntry id="rreturn_none_0"><text>-</text></inputEntry><inputEntry id="rreturn_none_1"><text>-</text></inputEntry><inputEntry id="rreturn_none_2"><text>-</text></inputEntry><inputEntry id="rreturn_none_3"><text>-</text></inputEntry><inputEntry id="rreturn_none_4"><text>-</text></inputEntry><inputEntry id="rreturn_none_5"><text>-</text></inputEntry><outputEntry id="oe_return_none"><text>0</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="score_intl" name="Axis score: International posture">
    <description>How active the international role is. EU follower 1; bilateral or bloc co-funding 3; standard-setter 5.</description>
    <informationRequirement id="ir_intl_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_intl_fol"><requiredInput href="#in_partial_intl_fol"/></informationRequirement>
    <informationRequirement id="ir_intl_std"><requiredInput href="#in_partial_intl_std"/></informationRequirement>
    <informationRequirement id="ir_intl_bil"><requiredInput href="#in_partial_intl_bil"/></informationRequirement>
    <informationRequirement id="ir_intl_bloc"><requiredInput href="#in_partial_intl_bloc"/></informationRequirement>
    <decisionTable id="dt_intl" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_intl_primary" label="primary option (coding.intl)"><inputExpression id="ie_intl_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_intl_fol" label="partial score for fol (0-5)"><inputExpression id="ie_intl_fol" typeRef="number"><text>partial_intl_fol</text></inputExpression></input>
      <input id="i_intl_std" label="partial score for std (0-5)"><inputExpression id="ie_intl_std" typeRef="number"><text>partial_intl_std</text></inputExpression></input>
      <input id="i_intl_bil" label="partial score for bil (0-5)"><inputExpression id="ie_intl_bil" typeRef="number"><text>partial_intl_bil</text></inputExpression></input>
      <input id="i_intl_bloc" label="partial score for bloc (0-5)"><inputExpression id="ie_intl_bloc" typeRef="number"><text>partial_intl_bloc</text></inputExpression></input>
      <output id="o_intl" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_intl_fol_primary"><description>EU follower: primary</description><inputEntry id="rintl_fol_p_0"><text>"fol"</text></inputEntry><inputEntry id="rintl_fol_p_1"><text>-</text></inputEntry><inputEntry id="rintl_fol_p_2"><text>-</text></inputEntry><inputEntry id="rintl_fol_p_3"><text>-</text></inputEntry><inputEntry id="rintl_fol_p_4"><text>-</text></inputEntry><outputEntry id="oe_intl_fol_p"><text>1</text></outputEntry></rule>
      <rule id="rule_intl_fol_partial"><description>EU follower: partial</description><inputEntry id="rintl_fol_s_0"><text>-</text></inputEntry><inputEntry id="rintl_fol_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="rintl_fol_s_2"><text>-</text></inputEntry><inputEntry id="rintl_fol_s_3"><text>-</text></inputEntry><inputEntry id="rintl_fol_s_4"><text>-</text></inputEntry><outputEntry id="oe_intl_fol_s"><text>1 * partial_intl_fol / 5</text></outputEntry></rule>
      <rule id="rule_intl_std_primary"><description>standard-setter: primary</description><inputEntry id="rintl_std_p_0"><text>"std"</text></inputEntry><inputEntry id="rintl_std_p_1"><text>-</text></inputEntry><inputEntry id="rintl_std_p_2"><text>-</text></inputEntry><inputEntry id="rintl_std_p_3"><text>-</text></inputEntry><inputEntry id="rintl_std_p_4"><text>-</text></inputEntry><outputEntry id="oe_intl_std_p"><text>5</text></outputEntry></rule>
      <rule id="rule_intl_std_partial"><description>standard-setter: partial</description><inputEntry id="rintl_std_s_0"><text>-</text></inputEntry><inputEntry id="rintl_std_s_1"><text>-</text></inputEntry><inputEntry id="rintl_std_s_2"><text>&gt; 0</text></inputEntry><inputEntry id="rintl_std_s_3"><text>-</text></inputEntry><inputEntry id="rintl_std_s_4"><text>-</text></inputEntry><outputEntry id="oe_intl_std_s"><text>5 * partial_intl_std / 5</text></outputEntry></rule>
      <rule id="rule_intl_bil_primary"><description>bilateral: primary</description><inputEntry id="rintl_bil_p_0"><text>"bil"</text></inputEntry><inputEntry id="rintl_bil_p_1"><text>-</text></inputEntry><inputEntry id="rintl_bil_p_2"><text>-</text></inputEntry><inputEntry id="rintl_bil_p_3"><text>-</text></inputEntry><inputEntry id="rintl_bil_p_4"><text>-</text></inputEntry><outputEntry id="oe_intl_bil_p"><text>3</text></outputEntry></rule>
      <rule id="rule_intl_bil_partial"><description>bilateral: partial</description><inputEntry id="rintl_bil_s_0"><text>-</text></inputEntry><inputEntry id="rintl_bil_s_1"><text>-</text></inputEntry><inputEntry id="rintl_bil_s_2"><text>-</text></inputEntry><inputEntry id="rintl_bil_s_3"><text>&gt; 0</text></inputEntry><inputEntry id="rintl_bil_s_4"><text>-</text></inputEntry><outputEntry id="oe_intl_bil_s"><text>3 * partial_intl_bil / 5</text></outputEntry></rule>
      <rule id="rule_intl_bloc_primary"><description>bloc co-funder: primary</description><inputEntry id="rintl_bloc_p_0"><text>"bloc"</text></inputEntry><inputEntry id="rintl_bloc_p_1"><text>-</text></inputEntry><inputEntry id="rintl_bloc_p_2"><text>-</text></inputEntry><inputEntry id="rintl_bloc_p_3"><text>-</text></inputEntry><inputEntry id="rintl_bloc_p_4"><text>-</text></inputEntry><outputEntry id="oe_intl_bloc_p"><text>3</text></outputEntry></rule>
