      <input id="i_gov_min" label="partial score for min (0-5)"><inputExpression id="ie_gov_min" typeRef="number"><text>partial_gov_min</text></inputExpression></input>
      <input id="i_gov_agy" label="partial score for agy (0-5)"><inputExpression id="ie_gov_agy" typeRef="number"><text>partial_gov_agy</text></inputExpression></input>
