      <rule id="rule_lang_ft_primary"><description>fine-tune: primary</description><inputEntry id="rlang_ft_p_0"><text>"ft"</text></inputEntry><inputEntry id="rlang_ft_p_1"><text>-</text></inputEntry><inputEntry id="rlang_ft_p_2"><text>-</text></inputEntry><inputEntry id="rlang_ft_p_3"><text>-</text></inputEntry><inputEntry id="rlang_ft_p_4"><text>-</text></inputEntry><inputEntry id="rlang_ft_p_5"><text>-</text></inputEntry><outputEntry id="oe_lang_ft_p"><text>3</text></outputEntry></rule>
      <rule id="rule_lang_ft_partial"><description>fine-tune: partial</description><inputEntry id="rlang_ft_s_0"><text>-</text></inputEntry><inputEntry id="rlang_ft_s_1"><text>-</text></inputEntry><inputEntry id="rlang_ft_s_2"><text>-</text></inputEntry><inputEntry id="rlang_ft_s_3"><text>&gt; 0</text></inputEntry><inputEntry id="rlang_ft_s_4"><text>-</text></inputEntry><inputEntry id="rlang_ft_s_5"><text>-</text></inputEntry><outputEntry id="oe_lang_ft_s"><text>3 * partial_lang_ft / 5</text></outputEntry></rule>
      <rule id="rule_lang_natl_primary"><description>national model: primary</description><inputEntry id="rlang_natl_p_0"><text>"natl"</text></inputEntry><inputEntry id="rlang_natl_p_1"><text>-</text></inputEntry><inputEntry id="rlang_natl_p_2"><text>-</text></inputEntry><inputEntry id="rlang_natl_p_3"><text>-</text></inputEntry><inputEntry id="rlang_natl_p_4"><text>-</text></inputEntry><inputEntry id="rlang_natl_p_5"><text>-</text></inputEntry><outputEntry id="oe_lang_natl_p"><text>5</text></outputEntry></rule>
