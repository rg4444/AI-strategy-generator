  </decision>
  <decision id="score_interest" name="Axis score: National interest">
    <description>Whether a country-specific reason is stated. Not stated 0; generic competitiveness 2; falling behind or trust 3; independence, service sustainability, diversification or language 4.</description>
    <informationRequirement id="ir_interest_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_interest_none"><requiredInput href="#in_partial_interest_none"/></informationRequirement>
    <informationRequirement id="ir_interest_demo"><requiredInput href="#in_partial_interest_demo"/></informationRequirement>
    <informationRequirement id="ir_interest_comp"><requiredInput href="#in_partial_interest_comp"/></informationRequirement>
    <informationRequirement id="ir_interest_indep"><requiredInput href="#in_partial_interest_indep"/></informationRequirement>
    <informationRequirement id="ir_interest_behind"><requiredInput href="#in_partial_interest_behind"/></informationRequirement>
    <informationRequirement id="ir_interest_svc"><requiredInput href="#in_partial_interest_svc"/></informationRequirement>
    <informationRequirement id="ir_interest_div"><requiredInput href="#in_partial_interest_div"/></informationRequirement>
    <informationRequirement id="ir_interest_trust"><requiredInput href="#in_partial_interest_trust"/></informationRequirement>
    <informationRequirement id="ir_interest_lang"><requiredInput href="#in_partial_interest_lang"/></informationRequirement>
    <decisionTable id="dt_interest" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_interest_primary" label="primary option (coding.interest)"><inputExpression id="ie_interest_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_interest_none" label="partial score for none (0-5)"><inputExpression id="ie_interest_none" typeRef="number"><text>partial_interest_none</text></inputExpression></input>
      <input id="i_interest_demo" label="partial score for demo (0-5)"><inputExpression id="ie_interest_demo" typeRef="number"><text>partial_interest_demo</text></inputExpression></input>
      <input id="i_interest_comp" label="partial score for comp (0-5)"><inputExpression id="ie_interest_comp" typeRef="number"><text>partial_interest_comp</text></inputExpression></input>
      <input id="i_interest_indep" label="partial score for indep (0-5)"><inputExpression id="ie_interest_indep" typeRef="number"><text>partial_interest_indep</text></inputExpression></input>
      <input id="i_interest_behind" label="partial score for behind (0-5)"><inputExpression id="ie_interest_behind" typeRef="number"><text>partial_interest_behind</text></inputExpression></input>
      <input id="i_interest_svc" label="partial score for svc (0-5)"><inputExpression id="ie_interest_svc" typeRef="number"><text>partial_interest_svc</text></inputExpression></input>
      <input id="i_interest_div" label="partial score for div (0-5)"><inputExpression id="ie_interest_div" typeRef="number"><text>partial_interest_div</text></inputExpression></input>
      <input id="i_interest_trust" label="partial score for trust (0-5)"><inputExpression id="ie_interest_trust" typeRef="number"><text>partial_interest_trust</text></inputExpression></input>
      <input id="i_interest_lang" label="partial score for lang (0-5)"><inputExpression id="ie_interest_lang" typeRef="number"><text>partial_interest_lang</text></inputExpression></input>
      <output id="o_interest" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_interest_none_primary"><description>not stated: primary</description><inputEntry id="rinterest_none_p_0"><text>"none"</text></inputEntry><inputEntry id="rinterest_none_p_1"><text>-</text></inputEntry><inputEntry id="rinterest_none_p_2"><text>-</text></inputEntry><inputEntry id="rinterest_none_p_3"><text>-</text></inputEntry><inputEntry id="rinterest_none_p_4"><text>-</text></inputEntry><inputEntry id="rinterest_none_p_5"><text>-</text></inputEntry><inputEntry id="rinterest_none_p_6"><text>-</text></inputEntry><inputEntry id="rinterest_none_p_7"><text>-</text></inputEntry><inputEntry id="rinterest_none_p_8"><text>-</text></inputEntry><inputEntry id="rinterest_none_p_9"><text>-</text></inputEntry><outputEntry id="oe_interest_none_p"><text>0</text></outputEntry></rule>
      <rule id="rule_interest_none_partial"><description>not stated: partial</description><inputEntry id="rinterest_none_s_0"><text>-</text></inputEntry><inputEntry id="rinterest_none_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="rinterest_none_s_2"><text>-</text></inputEntry><inputEntry id="rinterest_none_s_3"><text>-</text></inputEntry><inputEntry id="rinterest_none_s_4"><text>-</text></inputEntry><inputEntry id="rinterest_none_s_5"><text>-</text></inputEntry><inputEntry id="rinterest_none_s_6"><text>-</text></inputEntry><inputEntry id="rinterest_none_s_7"><text>-</text></inputEntry><inputEntry id="rinterest_none_s_8"><text>-</text></inputEntry><inputEntry id="rinterest_none_s_9"><text>-</text></inputEntry><outputEntry id="oe_interest_none_s"><text>0 * partial_interest_none / 5</text></outputEntry></rule>
      <rule id="rule_interest_demo_primary"><description>demographic decline: primary</description><inputEntry id="rinterest_demo_p_0"><text>"demo"</text></inputEntry><inputEntry id="rinterest_demo_p_1"><text>-</text></inputEntry><inputEntry id="rinterest_demo_p_2"><text>-</text></inputEntry><inputEntry id="rinterest_demo_p_3"><text>-</text></inputEntry><inputEntry id="rinterest_demo_p_4"><text>-</text></inputEntry><inputEntry id="rinterest_demo_p_5"><text>-</text></inputEntry><inputEntry id="rinterest_demo_p_6"><text>-</text></inputEntry><inputEntry id="rinterest_demo_p_7"><text>-</text></inputEntry><inputEntry id="rinterest_demo_p_8"><text>-</text></inputEntry><inputEntry id="rinterest_demo_p_9"><text>-</text></inputEntry><outputEntry id="oe_interest_demo_p"><text>4</text></outputEntry></rule>
