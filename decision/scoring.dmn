    </decisionTable>
  </decision>
  <decision id="score_lang" name="Axis score: Language strategy">
    <description>How far the national-language provision goes. None 0; data contribution 2; fine-tuning 3; regional consortium 4; national model 5.</description>
    <informationRequirement id="ir_lang_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_lang_none"><requiredInput href="#in_partial_lang_none"/></informationRequirement>
    <informationRequirement id="ir_lang_data"><requiredInput href="#in_partial_lang_data"/></informationRequirement>
    <informationRequirement id="ir_lang_ft"><requiredInput href="#in_partial_lang_ft"/></informationRequirement>
    <informationRequirement id="ir_lang_natl"><requiredInput href="#in_partial_lang_natl"/></informationRequirement>
    <informationRequirement id="ir_lang_reg"><requiredInput href="#in_partial_lang_reg"/></informationRequirement>
    <decisionTable id="dt_lang" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_lang_primary" label="primary option (coding.lang)"><inputExpression id="ie_lang_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_lang_none" label="partial score for none (0-5)"><inputExpression id="ie_lang_none" typeRef="number"><text>partial_lang_none</text></inputExpression></input>
      <input id="i_lang_data" label="partial score for data (0-5)"><inputExpression id="ie_lang_data" typeRef="number"><text>partial_lang_data</text></inputExpression></input>
      <input id="i_lang_ft" label="partial score for ft (0-5)"><inputExpression id="ie_lang_ft" typeRef="number"><text>partial_lang_ft</text></inputExpression></input>
      <input id="i_lang_natl" label="partial score for natl (0-5)"><inputExpression id="ie_lang_natl" typeRef="number"><text>partial_lang_natl</text></inputExpression></input>
      <input id="i_lang_reg" label="partial score for reg (0-5)"><inputExpression id="ie_lang_reg" typeRef="number"><text>partial_lang_reg</text></inputExpression></input>
      <output id="o_lang" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_lang_none_primary"><description>none: primary</description><inputEntry id="rlang_none_p_0"><text>"none"</text></inputEntry><inputEntry id="rlang_none_p_1"><text>-</text></inputEntry><inputEntry id="rlang_none_p_2"><text>-</text></inputEntry><inputEntry id="rlang_none_p_3"><text>-</text></inputEntry><inputEntry id="rlang_none_p_4"><text>-</text></inputEntry><inputEntry id="rlang_none_p_5"><text>-</text></inputEntry><outputEntry id="oe_lang_none_p"><text>0</text></outputEntry></rule>
