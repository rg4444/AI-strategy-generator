      <rule id="rule_doctype_vision_partial"><description>vision: partial</description><inputEntry id="rdoctype_vision_s_0"><text>-</text></inputEntry><inputEntry id="rdoctype_vision_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="rdoctype_vision_s_2"><text>-</text></inputEntry><inputEntry id="rdoctype_vision_s_3"><text>-</text></inputEntry><inputEntry id="rdoctype_vision_s_4"><text>-</text></inputEntry><outputEntry id="oe_doctype_vision_s"><text>2 * partial_doctype_vision / 5</text></outputEntry></rule>
      <rule id="rule_doctype_plan_primary"><description>plan with actions: primary</description><inputEntry id="rdoctype_plan_p_0"><text>"plan"</text></inputEntry><inputEntry id="rdoctype_plan_p_1"><text>-</text></inputEntry><inputEntry id="rdoctype_plan_p_2"><text>-</text></inputEntry><inputEntry id="rdoctype_plan_p_3"><text>-</text></inputEntry><inputEntry id="rdoctype_plan_p_4"><text>-</text></inputEntry><outputEntry id="oe_doctype_plan_p"><text>4</text></outputEntry></rule>
