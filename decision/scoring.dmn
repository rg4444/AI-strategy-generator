  <decision id="score_meas" name="Axis score: Measurement">
    <description>Whether the strategy can be tested. None 0; activity KPIs 2; outcome KPIs 4; public delivery tracker 5.</description>
    <informationRequirement id="ir_meas_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_meas_none"><requiredInput href="#in_partial_meas_none"/></informationRequirement>
    <informationRequirement id="ir_meas_act"><requiredInput href="#in_partial_meas_act"/></informationRequirement>
    <informationRequirement id="ir_meas_out"><requiredInput href="#in_partial_meas_out"/></informationRequirement>
    <informationRequirement id="ir_meas_trk"><requiredInput href="#in_partial_meas_trk"/></informationRequirement>
    <decisionTable id="dt_meas" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_meas_primary" label="primary option (coding.meas)"><inputExpression id="ie_meas_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_meas_none" label="partial score for none (0-5)"><inputExpression id="ie_meas_none" typeRef="number"><text>partial_meas_none</text></inputExpression></input>
      <input id="i_meas_act" label="partial score for act (0-5)"><inputExpression id="ie_meas_act" typeRef="number"><text>partial_meas_act</text></inputExpression></input>
      <input id="i_meas_out" label="partial score for out (0-5)"><inputExpression id="ie_meas_out" typeRef="number"><text>partial_meas_out</text></inputExpression></input>
      <input id="i_meas_trk" label="partial score for trk (0-5)"><inputExpression id="ie_meas_trk" typeRef="number"><text>partial_meas_trk</text></inputExpression></input>
      <output id="o_meas" label="axis score (0-5)" name="score" typeRef="number"/>
