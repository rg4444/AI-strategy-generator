      <rule id="rule_diff_compute_primary"><description>compute capacity: primary</description><inputEntry id="rdiff_compute_p_0"><text>"compute"</text></inputEntry><inputEntry id="rdiff_compute_p_1"><text>-</text></inputEntry><inputEntry id="rdiff_compute_p_2"><text>-</text></inputEntry><inputEntry id="rdiff_compute_p_3"><text>-</text></inputEntry><inputEntry id="rdiff_compute_p_4"><text>-</text></inputEntry><inputEntry id="rdiff_compute_p_5"><text>-</text></inputEntry><inputEntry id="rdiff_compute_p_6"><text>-</text></inputEntry><inputEntry id="rdiff_compute_p_7"><text>-</text></inputEntry><inputEntry id="rdiff_compute_p_8"><text>-</text></inputEntry><inputEntry id="rdiff_compute_p_9"><text>-</text></inputEntry><outputEntry id="oe_diff_compute_p"><text>4</text></outputEntry></rule>
      <rule id="rule_diff_compute_partial"><description>compute capacity: partial</description><inputEntry id="rdiff_compute_s_0"><text>-</text></inputEntry><inputEntry id="rdiff_compute_s_1"><text>-</text></inputEntry><inputEntry id="rdiff_compute_s_2"><text>-</text></inputEntry><inputEntry id="rdiff_compute_s_3"><text>-</text></inputEntry><inputEntry id="rdiff_compute_s_4"><text>-</text></inputEntry><inputEntry id="rdiff_compute_s_5"><text>&gt; 0</text></inputEntry><inputEntry id="rdiff_compute_s_6"><text>-</text></inputEntry><inputEntry id="rdiff_compute_s_7"><text>-</text></inputEntry><inputEntry id="rdiff_compute_s_8"><text>-</text></inputEntry><inputEntry id="rdiff_compute_s_9"><text>-</text></inputEntry><outputEntry id="oe_diff_compute_s"><text>4 * partial_diff_compute / 5</text></outputEntry></rule>
