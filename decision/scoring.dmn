  <decision id="score_gov" name="Axis score: Governance locus">
    <description>How much power there is to direct other institutions. Line ministry 2; central agency 4; head-of-government council or statutory body 5.</description>
    <informationRequirement id="ir_gov_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_gov_min"><requiredInput href="#in_partial_gov_min"/></informationRequirement>
    <informationRequirement id="ir_gov_agy"><requiredInput href="#in_partial_gov_agy"/></informationRequirement>
    <informationRequirement id="ir_gov_coun"><requiredInput href="#in_partial_gov_coun"/></informationRequirement>
    <informationRequirement id="ir_gov_stat"><requiredInput href="#in_partial_gov_stat"/></informationRequirement>
    <decisionTable id="dt_gov" hitPolicy="COLLECT" aggregation="MAX">
