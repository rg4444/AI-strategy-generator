    </decisionTable>
  </decision>
  <decision id="score_doctype" name="Axis score: Document type">
    <description>How binding the document is. Vision 2; plan or rolling portfolio 4; statute 5.</description>
    <informationRequirement id="ir_doctype_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_doctype_vision"><requiredInput href="#in_partial_doctype_vision"/></informationRequirement>
    <informationRequirement id="ir_doctype_plan"><requiredInput href="#in_partial_doctype_plan"/></informationRequirement>
    <informationRequirement id="ir_doctype_statute"><requiredInput href="#in_partial_doctype_statute"/></informationRequirement>
    <informationRequirement id="ir_doctype_rolling"><requiredInput href="#in_partial_doctype_rolling"/></informationRequirement>
    <decisionTable id="dt_doctype" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_doctype_primary" label="primary option (coding.doctype)"><inputExpression id="ie_doctype_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_doctype_vision" label="partial score for vision (0-5)"><inputExpression id="ie_doctype_vision" typeRef="number"><text>partial_doctype_vision</text></inputExpression></input>
