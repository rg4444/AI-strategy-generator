      <input id="i_gov_stat" label="partial score for stat (0-5)"><inputExpression id="ie_gov_stat" typeRef="number"><text>partial_gov_stat</text></inputExpression></input>
      <output id="o_gov" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_gov_min_primary"><description>line ministry: primary</description><inputEntry id="rgov_min_p_0"><text>"min"</text></inputEntry><inputEntry id="rgov_min_p_1"><text>-</text></inputEntry><inputEntry id="rgov_min_p_2"><text>-</text></inputEntry><inputEntry id="rgov_min_p_3"><text>-</text></inputEntry><inputEntry id="rgov_min_p_4"><text>-</text></inputEntry><outputEntry id="oe_gov_min_p"><text>2</text></outputEntry></rule>
      <rule id="rule_gov_min_partial"><description>line ministry: partial</description><inputEntry id="rgov_min_s_0"><text>-</text></inputEntry><inputEntry id="rgov_min_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="rgov_min_s_2"><text>-</text></inputEntry><inputEntry id="rgov_min_s_3"><text>-</text></inputEntry><inputEntry id="rgov_min_s_4"><text>-</text></inputEntry><outputEntry id="oe_gov_min_s"><text>2 * partial_gov_min / 5</text></outputEntry></rule>
      <rule id="rule_gov_agy_primary"><description>central digital agency: primary</description><inputEntry id="rgov_agy_p_0"><text>"agy"</text></inputEntry><inputEntry id="rgov_agy_p_1"><text>-</text></inputEntry><inputEntry id="rgov_agy_p_2"><text>-</text></inputEntry><inputEntry id="rgov_agy_p_3"><text>-</text></inputEntry><inputEntry id="rgov_agy_p_4"><text>-</text></inputEntry><outputEntry id="oe_gov_agy_p"><text>4</text></outputEntry></rule>
      <rule id="rule_gov_agy_partial"><description>central digital agency: partial</description><inputEntry id="rgov_agy_s_0"><text>-</text></inputEntry><inputEntry id="rgov_agy_s_1"><text>-</text></inputEntry><inputEntry id="rgov_agy_s_2"><text>&gt; 0</text></inputEntry><inputEntry id="rgov_agy_s_3"><text>-</text></inputEntry><inputEntry id="rgov_agy_s_4"><text>-</text></inputEntry><outputEntry id="oe_gov_agy_s"><text>4 * partial_gov_agy / 5</text></outputEntry></rule>
      <rule id="rule_gov_coun_primary"><description>head-of-government council: primary</description><inputEntry id="rgov_coun_p_0"><text>"coun"</text></inputEntry><inputEntry id="rgov_coun_p_1"><text>-</text></inputEntry><inputEntry id="rgov_coun_p_2"><text>-</text></inputEntry><inputEntry id="rgov_coun_p_3"><text>-</text></inputEntry><inputEntry id="rgov_coun_p_4"><text>-</text></inputEntry><outputEntry id="oe_gov_coun_p"><text>5</text></outputEntry></rule>
      <rule id="rule_gov_coun_partial"><description>head-of-government council: partial</description><inputEntry id="rgov_coun_s_0"><text>-</text></inputEntry><inputEntry id="rgov_coun_s_1"><text>-</text></inputEntry><inputEntry id="rgov_coun_s_2"><text>-</text></inputEntry><inputEntry id="rgov_coun_s_3"><text>&gt; 0</text></inputEntry><inputEntry id="rgov_coun_s_4"><text>-</text></inputEntry><outputEntry id="oe_gov_coun_s"><text>5 * partial_gov_coun / 5</text></outputEntry></rule>
      <rule id="rule_gov_stat_primary"><description>statutory body: primary</description><inputEntry id="rgov_stat_p_0"><text>"stat"</text></inputEntry><inputEntry id="rgov_stat_p_1"><text>-</text></inputEntry><inputEntry id="rgov_stat_p_2"><text>-</text></inputEntry><inputEntry id="rgov_stat_p_3"><text>-</text></inputEntry><inputEntry id="rgov_stat_p_4"><text>-</text></inputEntry><outputEntry id="oe_gov_stat_p"><text>5</text></outputEntry></rule>
      <rule id="rule_gov_stat_partial"><description>statutory body: partial</description><inputEntry id="rgov_stat_s_0"><text>-</text></inputEntry><inputEntry id="rgov_stat_s_1"><text>-</text></inputEntry><inputEntry id="rgov_stat_s_2"><text>-</text></inputEntry><inputEntry id="rgov_stat_s_3"><text>-</text></inputEntry><inputEntry id="rgov_stat_s_4"><text>&gt; 0</text></inputEntry><outputEntry id="oe_gov_stat_s"><text>5 * partial_gov_stat / 5</text></outputEntry></rule>
      <rule id="rule_gov_undecided"><description>undecided / no partials</description><inputEntry id="rgov_none_0"><text>-</text></inputEntry><inputEntry id="rgov_none_1"><text>-</text></inputEntry><inputEntry id="rgov_none_2"><text>-</text></inputEntry><inputEntry id="rgov_none_3"><text>-</text></inputEntry><inputEntry id="rgov_none_4"><text>-</text></inputEntry><outputEntry id="oe_gov_none"><text>0</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="score_reg" name="Axis score: Regulatory posture">
    <description>How settled the regulatory stance is. EU transposition only 1; soft law 2; sandbox 4; statutory framework 5.</description>
    <informationRequirement id="ir_reg_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_reg_stat"><requiredInput href="#in_partial_reg_stat"/></informationRequirement>
    <informationRequirement id="ir_reg_sand"><requiredInput href="#in_partial_reg_sand"/></informationRequirement>
    <informationRequirement id="ir_reg_soft"><requiredInput href="#in_partial_reg_soft"/></informationRequirement>
    <informationRequirement id="ir_reg_eu"><requiredInput href="#in_partial_reg_eu"/></informationRequirement>
    <decisionTable id="dt_reg" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_reg_primary" label="primary option (coding.reg)"><inputExpression id="ie_reg_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_reg_stat" label="partial score for stat (0-5)"><inputExpression id="ie_reg_stat" typeRef="number"><text>partial_reg_stat</text></inputExpression></input>
      <input id="i_reg_sand" label="partial score for sand (0-5)"><inputExpression id="ie_reg_sand" typeRef="number"><text>partial_reg_sand</text></inputExpression></input>
      <input id="i_reg_soft" label="partial score for soft (0-5)"><inputExpression id="ie_reg_soft" typeRef="number"><text>partial_reg_soft</text></inputExpression></input>
      <input id="i_reg_eu" label="partial score for eu (0-5)"><inputExpression id="ie_reg_eu" typeRef="number"><text>partial_reg_eu</text></inputExpression></input>
      <output id="o_reg" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_reg_stat_primary"><description>statutory framework: primary</description><inputEntry id="rreg_stat_p_0"><text>"stat"</text></inputEntry><inputEntry id="rreg_stat_p_1"><text>-</text></inputEntry><inputEntry id="rreg_stat_p_2"><text>-</text></inputEntry><inputEntry id="rreg_stat_p_3"><text>-</text></inputEntry><inputEntry id="rreg_stat_p_4"><text>-</text></inputEntry><outputEntry id="oe_reg_stat_p"><text>0</text></outputEntry></rule>
      <rule id="rule_reg_stat_partial"><description>statutory framework: partial</description><inputEntry id="rreg_stat_s_0"><text>-</text></inputEntry><inputEntry id="rreg_stat_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="rreg_stat_s_2"><text>-</text></inputEntry><inputEntry id="rreg_stat_s_3"><text>-</text></inputEntry><inputEntry id="rreg_stat_s_4"><text>-</text></inputEntry><outputEntry id="oe_reg_stat_s"><text>0 * partial_reg_stat / 5</text></outputEntry></rule>
      <rule id="rule_reg_sand_primary"><description>sandbox-first: primary</description><inputEntry id="rreg_sand_p_0"><text>"sand"</text></inputEntry><inputEntry id="rreg_sand_p_1"><text>-</text></inputEntry><inputEntry id="rreg_sand_p_2"><text>-</text></inputEntry><inputEntry id="rreg_sand_p_3"><text>-</text></inputEntry><inputEntry id="rreg_sand_p_4"><text>-</text></inputEntry><outputEntry id="oe_reg_sand_p"><text>0</text></outputEntry></rule>
      <rule id="rule_reg_sand_partial"><description>sandbox-first: partial</description><inputEntry id="rreg_sand_s_0"><text>-</text></inputEntry><inputEntry id="rreg_sand_s_1"><text>-</text></inputEntry><inputEntry id="rreg_sand_s_2"><text>&gt; 0</text></inputEntry><inputEntry id="rreg_sand_s_3"><text>-</text></inputEntry><inputEntry id="rreg_sand_s_4"><text>-</text></inputEntry><outputEntry id="oe_reg_sand_s"><text>0 * partial_reg_sand / 5</text></outputEntry></rule>
      <rule id="rule_reg_soft_primary"><description>soft law: primary</description><inputEntry id="rreg_soft_p_0"><text>"soft"</text></inputEntry><inputEntry id="rreg_soft_p_1"><text>-</text></inputEntry><inputEntry id="rreg_soft_p_2"><text>-</text></inputEntry><inputEntry id="rreg_soft_p_3"><text>-</text></inputEntry><inputEntry id="rreg_soft_p_4"><text>-</text></inputEntry><outputEntry id="oe_reg_soft_p"><text>0</text></outputEntry></rule>
      <rule id="rule_reg_soft_partial"><description>soft law: partial</description><inputEntry id="rreg_soft_s_0"><text>-</text></inputEntry><inputEntry id="rreg_soft_s_1"><text>-</text></inputEntry><inputEntry id="rreg_soft_s_2"><text>-</text></inputEntry><inputEntry id="rreg_soft_s_3"><text>&gt; 0</text></inputEntry><inputEntry id="rreg_soft_s_4"><text>-</text></inputEntry><outputEntry id="oe_reg_soft_s"><text>0 * partial_reg_soft / 5</text></outputEntry></rule>
      <rule id="rule_reg_eu_primary"><description>EU transposition only: primary</description><inputEntry id="rreg_eu_p_0"><text>"eu"</text></inputEntry><inputEntry id="rreg_eu_p_1"><text>-</text></inputEntry><inputEntry id="rreg_eu_p_2"><text>-</text></inputEntry><inputEntry id="rreg_eu_p_3"><text>-</text></inputEntry><inputEntry id="rreg_eu_p_4"><text>-</text></inputEntry><outputEntry id="oe_reg_eu_p"><text>0</text></outputEntry></rule>
      <rule id="rule_reg_eu_partial"><description>EU transposition only: partial</description><inputEntry id="rreg_eu_s_0"><text>-</text></inputEntry><inputEntry id="rreg_eu_s_1"><text>-</text></inputEntry><inputEntry id="rreg_eu_s_2"><text>-</text></inputEntry><inputEntry id="rreg_eu_s_3"><text>-</text></inputEntry><inputEntry id="rreg_eu_s_4"><text>&gt; 0</text></inputEntry><outputEntry id="oe_reg_eu_s"><text>0 * partial_reg_eu / 5</text></outputEntry></rule>
      <rule id="rule_reg_undecided"><description>undecided / no partials</description><inputEntry id="rreg_none_0"><text>-</text></inputEntry><inputEntry id="rreg_none_1"><text>-</text></inputEntry><inputEntry id="rreg_none_2"><text>-</text></inputEntry><inputEntry id="rreg_none_3"><text>-</text></inputEntry><inputEntry id="rreg_none_4"><text>-</text></inputEntry><outputEntry id="oe_reg_none"><text>0</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="overall" name="Weighted overall score (group A only)">
    <description>Weighted mean of the group-A axis scores. Weights are percent points and need not sum to 100; group-B axes (form and governance) are displayed but never enter the total.</description>
    <informationRequirement id="ir_overall_frame"><requiredDecision href="#score_frame"/></informationRequirement>
    <informationRequirement id="ir_overall_diff"><requiredDecision href="#score_diff"/></informationRequirement>
    <informationRequirement id="ir_overall_interest"><requiredDecision href="#score_interest"/></informationRequirement>
    <informationRequirement id="ir_overall_ambition"><requiredDecision href="#score_ambition"/></informationRequirement>
    <informationRequirement id="ir_overall_fund"><requiredDecision href="#score_fund"/></informationRequirement>
    <informationRequirement id="ir_overall_sourcing"><requiredDecision href="#score_sourcing"/></informationRequirement>
    <informationRequirement id="ir_overall_compute"><requiredDecision href="#score_compute"/></informationRequirement>
    <informationRequirement id="ir_overall_lang"><requiredDecision href="#score_lang"/></informationRequirement>
    <informationRequirement id="ir_overall_identity"><requiredDecision href="#score_identity"/></informationRequirement>
    <informationRequirement id="ir_overall_knowledge"><requiredDecision href="#score_knowledge"/></informationRequirement>
    <informationRequirement id="ir_overall_adopt"><requiredDecision href="#score_adopt"/></informationRequirement>
    <informationRequirement id="ir_overall_access"><requiredDecision href="#score_access"/></informationRequirement>
    <informationRequirement id="ir_overall_meas"><requiredDecision href="#score_meas"/></informationRequirement>
    <informationRequirement id="ir_overall_eval"><requiredDecision href="#score_eval"/></informationRequirement>
    <informationRequirement id="ir_overall_return"><requiredDecision href="#score_return"/></informationRequirement>
    <informationRequirement id="ir_overall_intl"><requiredDecision href="#score_intl"/></informationRequirement>
    <literalExpression id="le_overall"><text>if (5 + 8 + 10 + 8 + 12 + 10 + 5 + 5 + 6 + 5 + 8 + 8 + 8 + 5 + 6 + 5) = 0 then null else ((5 * score_frame) + (8 * score_diff) + (10 * score_interest) + (8 * score_ambition) + (12 * score_fund) + (10 * score_sourcing) + (5 * score_compute) + (5 * score_lang) + (6 * score_identity) + (5 * score_knowledge) + (8 * score_adopt) + (8 * score_access) + (8 * score_meas) + (5 * score_eval) + (6 * score_return) + (5 * score_intl)) / (5 + 8 + 10 + 8 + 12 + 10 + 5 + 5 + 6 + 5 + 8 + 8 + 8 + 5 + 6 + 5)</text></literalExpression>
  </decision>
</definitions>
