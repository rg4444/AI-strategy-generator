    </decisionTable>
  </decision>
  <decision id="score_access" name="Axis score: Citizen access to AI">
    <description>What the state commits to on citizens' access to general-purpose AI — a market matter, a skills matter, part of public services, or a public service the state funds for everyone. Market 1; skills 2; AI inside public services 3; free access for target groups 4; universal free access 5.</description>
    <informationRequirement id="ir_access_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_access_none"><requiredInput href="#in_partial_access_none"/></informationRequirement>
    <informationRequirement id="ir_access_market"><requiredInput href="#in_partial_access_market"/></informationRequirement>
    <informationRequirement id="ir_access_skills"><requiredInput href="#in_partial_access_skills"/></informationRequirement>
    <informationRequirement id="ir_access_services"><requiredInput href="#in_partial_access_services"/></informationRequirement>
    <informationRequirement id="ir_access_targeted"><requiredInput href="#in_partial_access_targeted"/></informationRequirement>
    <informationRequirement id="ir_access_universal"><requiredInput href="#in_partial_access_universal"/></informationRequirement>
    <decisionTable id="dt_access" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_access_primary" label="primary option (coding.access)"><inputExpression id="ie_access_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_access_none" label="partial score for none (0-5)"><inputExpression id="ie_access_none" typeRef="number"><text>partial_access_none</text></inputExpression></input>
      <input id="i_access_market" label="partial score for market (0-5)"><inputExpression id="ie_access_market" typeRef="number"><text>partial_access_market</text></inputExpression></input>
      <input id="i_access_skills" label="partial score for skills (0-5)"><inputExpression id="ie_access_skills" typeRef="number"><text>partial_access_skills</text></inputExpression></input>
      <input id="i_access_services" label="partial score for services (0-5)"><inputExpression id="ie_access_services" typeRef="number"><text>partial_access_services</text></inputExpression></input>
      <input id="i_access_targeted" label="partial score for targeted (0-5)"><inputExpression id="ie_access_targeted" typeRef="number"><text>partial_access_targeted</text></inputExpression></input>
      <input id="i_access_universal" label="partial score for universal (0-5)"><inputExpression id="ie_access_universal" typeRef="number"><text>partial_access_universal</text></inputExpression></input>
      <output id="o_access" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_access_none_primary"><description>not stated: primary</description><inputEntry id="raccess_none_p_0"><text>"none"</text></inputEntry><inputEntry id="raccess_none_p_1"><text>-</text></inputEntry><inputEntry id="raccess_none_p_2"><text>-</text></inputEntry><inputEntry id="raccess_none_p_3"><text>-</text></inputEntry><inputEntry id="raccess_none_p_4"><text>-</text></inputEntry><inputEntry id="raccess_none_p_5"><text>-</text></inputEntry><inputEntry id="raccess_none_p_6"><text>-</text></inputEntry><outputEntry id="oe_access_none_p"><text>0</text></outputEntry></rule>
      <rule id="rule_access_none_partial"><description>not stated: partial</description><inputEntry id="raccess_none_s_0"><text>-</text></inputEntry><inputEntry id="raccess_none_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="raccess_none_s_2"><text>-</text></inputEntry><inputEntry id="raccess_none_s_3"><text>-</text></inputEntry><inputEntry id="raccess_none_s_4"><text>-</text></inputEntry><inputEntry id="raccess_none_s_5"><text>-</text></inputEntry><inputEntry id="raccess_none_s_6"><text>-</text></inputEntry><outputEntry id="oe_access_none_s"><text>0 * partial_access_none / 5</text></outputEntry></rule>
      <rule id="rule_access_market_primary"><description>market provides: primary</description><inputEntry id="raccess_market_p_0"><text>"market"</text></inputEntry><inputEntry id="raccess_market_p_1"><text>-</text></inputEntry><inputEntry id="raccess_market_p_2"><text>-</text></inputEntry><inputEntry id="raccess_market_p_3"><text>-</text></inputEntry><inputEntry id="raccess_market_p_4"><text>-</text></inputEntry><inputEntry id="raccess_market_p_5"><text>-</text></inputEntry><inputEntry id="raccess_market_p_6"><text>-</text></inputEntry><outputEntry id="oe_access_market_p"><text>1</text></outputEntry></rule>
      <rule id="rule_access_market_partial"><description>market provides: partial</description><inputEntry id="raccess_market_s_0"><text>-</text></inputEntry><inputEntry id="raccess_market_s_1"><text>-</text></inputEntry><inputEntry id="raccess_market_s_2"><text>&gt; 0</text></inputEntry><inputEntry id="raccess_market_s_3"><text>-</text></inputEntry><inputEntry id="raccess_market_s_4"><text>-</text></inputEntry><inputEntry id="raccess_market_s_5"><text>-</text></inputEntry><inputEntry id="raccess_market_s_6"><text>-</text></inputEntry><outputEntry id="oe_access_market_s"><text>1 * partial_access_market / 5</text></outputEntry></rule>
      <rule id="rule_access_skills_primary"><description>skills and awareness: primary</description><inputEntry id="raccess_skills_p_0"><text>"skills"</text></inputEntry><inputEntry id="raccess_skills_p_1"><text>-</text></inputEntry><inputEntry id="raccess_skills_p_2"><text>-</text></inputEntry><inputEntry id="raccess_skills_p_3"><text>-</text></inputEntry><inputEntry id="raccess_skills_p_4"><text>-</text></inputEntry><inputEntry id="raccess_skills_p_5"><text>-</text></inputEntry><inputEntry id="raccess_skills_p_6"><text>-</text></inputEntry><outputEntry id="oe_access_skills_p"><text>2</text></outputEntry></rule>
      <rule id="rule_access_skills_partial"><description>skills and awareness: partial</description><inputEntry id="raccess_skills_s_0"><text>-</text></inputEntry><inputEntry id="raccess_skills_s_1"><text>-</text></inputEntry><inputEntry id="raccess_skills_s_2"><text>-</text></inputEntry><inputEntry id="raccess_skills_s_3"><text>&gt; 0</text></inputEntry><inputEntry id="raccess_skills_s_4"><text>-</text></inputEntry><inputEntry id="raccess_skills_s_5"><text>-</text></inputEntry><inputEntry id="raccess_skills_s_6"><text>-</text></inputEntry><outputEntry id="oe_access_skills_s"><text>2 * partial_access_skills / 5</text></outputEntry></rule>
      <rule id="rule_access_services_primary"><description>AI inside public services: primary</description><inputEntry id="raccess_services_p_0"><text>"services"</text></inputEntry><inputEntry id="raccess_services_p_1"><text>-</text></inputEntry><inputEntry id="raccess_services_p_2"><text>-</text></inputEntry><inputEntry id="raccess_services_p_3"><text>-</text></inputEntry><inputEntry id="raccess_services_p_4"><text>-</text></inputEntry><inputEntry id="raccess_services_p_5"><text>-</text></inputEntry><inputEntry id="raccess_services_p_6"><text>-</text></inputEntry><outputEntry id="oe_access_services_p"><text>3</text></outputEntry></rule>
