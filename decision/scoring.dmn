    </decisionTable>
  </decision>
  <decision id="score_eval" name="Axis score: Evaluation &amp; memory">
    <description>Whether learning accumulates. None 0; solution catalogue 2; evaluation function 4; what-works centre 5.</description>
    <informationRequirement id="ir_eval_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_eval_none"><requiredInput href="#in_partial_eval_none"/></informationRequirement>
    <informationRequirement id="ir_eval_cat"><requiredInput href="#in_partial_eval_cat"/></informationRequirement>
    <informationRequirement id="ir_eval_fn"><requiredInput href="#in_partial_eval_fn"/></informationRequirement>
    <informationRequirement id="ir_eval_ww"><requiredInput href="#in_partial_eval_ww"/></informationRequirement>
    <decisionTable id="dt_eval" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_eval_primary" label="primary option (coding.eval)"><inputExpression id="ie_eval_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_eval_none" label="partial score for none (0-5)"><inputExpression id="ie_eval_none" typeRef="number"><text>partial_eval_none</text></inputExpression></input>
      <input id="i_eval_cat" label="partial score for cat (0-5)"><inputExpression id="ie_eval_cat" typeRef="number"><text>partial_eval_cat</text></inputExpression></input>
      <input id="i_eval_fn" label="partial score for fn (0-5)"><inputExpression id="ie_eval_fn" typeRef="number"><text>partial_eval_fn</text></inputExpression></input>
      <input id="i_eval_ww" label="partial score for ww (0-5)"><inputExpression id="ie_eval_ww" typeRef="number"><text>partial_eval_ww</text></inputExpression></input>
      <output id="o_eval" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_eval_none_primary"><description>none: primary</description><inputEntry id="reval_none_p_0"><text>"none"</text></inputEntry><inputEntry id="reval_none_p_1"><text>-</text></inputEntry><inputEntry id="reval_none_p_2"><text>-</text></inputEntry><inputEntry id="reval_none_p_3"><text>-</text></inputEntry><inputEntry id="reval_none_p_4"><text>-</text></inputEntry><outputEntry id="oe_eval_none_p"><text>0</text></outputEntry></rule>
      <rule id="rule_eval_none_partial"><description>none: partial</description><inputEntry id="reval_none_s_0"><text>-</text></inputEntry><inputEntry id="reval_none_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="reval_none_s_2"><text>-</text></inputEntry><inputEntry id="reval_none_s_3"><text>-</text></inputEntry><inputEntry id="reval_none_s_4"><text>-</text></inputEntry><outputEntry id="oe_eval_none_s"><text>0 * partial_eval_none / 5</text></outputEntry></rule>
      <rule id="rule_eval_cat_primary"><description>solution catalogue: primary</description><inputEntry id="reval_cat_p_0"><text>"cat"</text></inputEntry><inputEntry id="reval_cat_p_1"><text>-</text></inputEntry><inputEntry id="reval_cat_p_2"><text>-</text></inputEntry><inputEntry id="reval_cat_p_3"><text>-</text></inputEntry><inputEntry id="reval_cat_p_4"><text>-</text></inputEntry><outputEntry id="oe_eval_cat_p"><text>2</text></outputEntry></rule>
      <rule id="rule_eval_cat_partial"><description>solution catalogue: partial</description><inputEntry id="reval_cat_s_0"><text>-</text></inputEntry><inputEntry id="reval_cat_s_1"><text>-</text></inputEntry><inputEntry id="reval_cat_s_2"><text>&gt; 0</text></inputEntry><inputEntry id="reval_cat_s_3"><text>-</text></inputEntry><inputEntry id="reval_cat_s_4"><text>-</text></inputEntry><outputEntry id="oe_eval_cat_s"><text>2 * partial_eval_cat / 5</text></outputEntry></rule>
      <rule id="rule_eval_fn_primary"><description>evaluation function: primary</description><inputEntry id="reval_fn_p_0"><text>"fn"</text></inputEntry><inputEntry id="reval_fn_p_1"><text>-</text></inputEntry><inputEntry id="reval_fn_p_2"><text>-</text></inputEntry><inputEntry id="reval_fn_p_3"><text>-</text></inputEntry><inputEntry id="reval_fn_p_4"><text>-</text></inputEntry><outputEntry id="oe_eval_fn_p"><text>4</text></outputEntry></rule>
      <rule id="rule_eval_fn_partial"><description>evaluation function: partial</description><inputEntry id="reval_fn_s_0"><text>-</text></inputEntry><inputEntry id="reval_fn_s_1"><text>-</text></inputEntry><inputEntry id="reval_fn_s_2"><text>-</text></inputEntry><inputEntry id="reval_fn_s_3"><text>&gt; 0</text></inputEntry><inputEntry id="reval_fn_s_4"><text>-</text></inputEntry><outputEntry id="oe_eval_fn_s"><text>4 * partial_eval_fn / 5</text></outputEntry></rule>
      <rule id="rule_eval_ww_primary"><description>what-works centre: primary</description><inputEntry id="reval_ww_p_0"><text>"ww"</text></inputEntry><inputEntry id="reval_ww_p_1"><text>-</text></inputEntry><inputEntry id="reval_ww_p_2"><text>-</text></inputEntry><inputEntry id="reval_ww_p_3"><text>-</text></inputEntry><inputEntry id="reval_ww_p_4"><text>-</text></inputEntry><outputEntry id="oe_eval_ww_p"><text>5</text></outputEntry></rule>
