      <rule id="rule_adopt_proc_primary"><description>procurement-led: primary</description><inputEntry id="radopt_proc_p_0"><text>"proc"</text></inputEntry><inputEntry id="radopt_proc_p_1"><text>-</text></inputEntry><inputEntry id="radopt_proc_p_2"><text>-</text></inputEntry><inputEntry id="radopt_proc_p_3"><text>-</text></inputEntry><inputEntry id="radopt_proc_p_4"><text>-</text></inputEntry><inputEntry id="radopt_proc_p_5"><text>-</text></inputEntry><outputEntry id="oe_adopt_proc_p"><text>4</text></outputEntry></rule>
