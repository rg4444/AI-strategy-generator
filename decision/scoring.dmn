      <rule id="rule_diff_res_primary"><description>talent and research: primary</description><inputEntry id="rdiff_res_p_0"><text>"res"</text></inputEntry><inputEntry id="rdiff_res_p_1"><text>-</text></inputEntry><inputEntry id="rdiff_res_p_2"><text>-</text></inputEntry><inputEntry id="rdiff_res_p_3"><text>-</text></inputEntry><inputEntry id="rdiff_res_p_4"><text>-</text></inputEntry><inputEntry id="rdiff_res_p_5"><text>-</text></inputEntry><inputEntry id="rdiff_res_p_6"><text>-</text></inputEntry><inputEntry id="rdiff_res_p_7"><text>-</text></inputEntry><inputEntry id="rdiff_res_p_8"><text>-</text></inputEntry><inputEntry id="rdiff_res_p_9"><text>-</text></inputEntry><outputEntry id="oe_diff_res_p"><text>3</text></outputEntry></rule>
