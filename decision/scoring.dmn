      <rule id="rule_adopt_mand_primary"><description>mandates: primary</description><inputEntry id="radopt_mand_p_0"><text>"mand"</text></inputEntry><inputEntry id="radopt_mand_p_1"><text>-</text></inputEntry><inputEntry id="radopt_mand_p_2"><text>-</text></inputEntry><inputEntry id="radopt_mand_p_3"><text>-</text></inputEntry><inputEntry id="radopt_mand_p_4"><text>-</text></inputEntry><inputEntry id="radopt_mand_p_5"><text>-</text></inputEntry><outputEntry id="oe_adopt_mand_p"><text>3</text></outputEntry></rule>
