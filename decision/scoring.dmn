      <input id="i_doctype_statute" label="partial score for statute (0-5)"><inputExpression id="ie_doctype_statute" typeRef="number"><text>partial_doctype_statute</text></inputExpression></input>
      <input id="i_doctype_rolling" label="partial score for rolling (0-5)"><inputExpression id="ie_doctype_rolling" typeRef="number"><text>partial_doctype_rolling</text></inputExpression></input>
      <output id="o_doctype" label="axis score (0-5)" name="score" typeRef="number"/>
