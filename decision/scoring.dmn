  <decision id="score_ambition" name="Axis score: Ambition type">
    <description>The form the end state takes. Reputation 1; capability 3; a number with a year 5. This measures testability, not ambition level.</description>
    <informationRequirement id="ir_ambition_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_ambition_reput"><requiredInput href="#in_partial_ambition_reput"/></informationRequirement>
    <informationRequirement id="ir_ambition_cap"><requiredInput href="#in_partial_ambition_cap"/></informationRequirement>
    <informationRequirement id="ir_ambition_quant"><requiredInput href="#in_partial_ambition_quant"/></informationRequirement>
    <decisionTable id="dt_ambition" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_ambition_primary" label="primary option (coding.ambition)"><inputExpression id="ie_ambition_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_ambition_reput" label="partial score for reput (0-5)"><inputExpression id="ie_ambition_reput" typeRef="number"><text>partial_ambition_reput</text></inputExpression></input>
      <input id="i_ambition_cap" label="partial score for cap (0-5)"><inputExpression id="ie_ambition_cap" typeRef="number"><text>partial_ambition_cap</text></inputExpression></input>
      <input id="i_ambition_quant" label="partial score for quant (0-5)"><inputExpression id="ie_ambition_quant" typeRef="number"><text>partial_ambition_quant</text></inputExpression></input>
      <output id="o_ambition" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_ambition_reput_primary"><description>reputational: primary</description><inputEntry id="rambition_reput_p_0"><text>"reput"</text></inputEntry><inputEntry id="rambition_reput_p_1"><text>-</text></inputEntry><inputEntry id="rambition_reput_p_2"><text>-</text></inputEntry><inputEntry id="rambition_reput_p_3"><text>-</text></inputEntry><outputEntry id="oe_ambition_reput_p"><text>1</text></outputEntry></rule>
      <rule id="rule_ambition_reput_partial"><description>reputational: partial</description><inputEntry id="rambition_reput_s_0"><text>-</text></inputEntry><inputEntry id="rambition_reput_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="rambition_reput_s_2"><text>-</text></inputEntry><inputEntry id="rambition_reput_s_3"><text>-</text></inputEntry><outputEntry id="oe_ambition_reput_s"><text>1 * partial_ambition_reput / 5</text></outputEntry></rule>
      <rule id="rule_ambition_cap_primary"><description>capability: primary</description><inputEntry id="rambition_cap_p_0"><text>"cap"</text></inputEntry><inputEntry id="rambition_cap_p_1"><text>-</text></inputEntry><inputEntry id="rambition_cap_p_2"><text>-</text></inputEntry><inputEntry id="rambition_cap_p_3"><text>-</text></inputEntry><outputEntry id="oe_ambition_cap_p"><text>3</text></outputEntry></rule>
      <rule id="rule_ambition_cap_partial"><description>capability: partial</description><inputEntry id="rambition_cap_s_0"><text>-</text></inputEntry><inputEntry id="rambition_cap_s_1"><text>-</text></inputEntry><inputEntry id="rambition_cap_s_2"><text>&gt; 0</text></inputEntry><inputEntry id="rambition_cap_s_3"><text>-</text></inputEntry><outputEntry id="oe_ambition_cap_s"><text>3 * partial_ambition_cap / 5</text></outputEntry></rule>
      <rule id="rule_ambition_quant_primary"><description>material / quantified: primary</description><inputEntry id="rambition_quant_p_0"><text>"quant"</text></inputEntry><inputEntry id="rambition_quant_p_1"><text>-</text></inputEntry><inputEntry id="rambition_quant_p_2"><text>-</text></inputEntry><inputEntry id="rambition_quant_p_3"><text>-</text></inputEntry><outputEntry id="oe_ambition_quant_p"><text>5</text></outputEntry></rule>
      <rule id="rule_ambition_quant_partial"><description>material / quantified: partial</description><inputEntry id="rambition_quant_s_0"><text>-</text></inputEntry><inputEntry id="rambition_quant_s_1"><text>-</text></inputEntry><inputEntry id="rambition_quant_s_2"><text>-</text></inputEntry><inputEntry id="rambition_quant_s_3"><text>&gt; 0</text></inputEntry><outputEntry id="oe_ambition_quant_s"><text>5 * partial_ambition_quant / 5</text></outputEntry></rule>
      <rule id="rule_ambition_undecided"><description>undecided / no partials</description><inputEntry id="rambition_none_0"><text>-</text></inputEntry><inputEntry id="rambition_none_1"><text>-</text></inputEntry><inputEntry id="rambition_none_2"><text>-</text></inputEntry><inputEntry id="rambition_none_3"><text>-</text></inputEntry><outputEntry id="oe_ambition_none"><text>0</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="score_fund" name="Axis score: Funding model">
    <description>Whether money is attached. Unfunded 0; budget line 3; PPP vehicle 4; dedicated multi-year fund 5.</description>
    <informationRequirement id="ir_fund_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_fund_un"><requiredInput href="#in_partial_fund_un"/></informationRequirement>
    <informationRequirement id="ir_fund_line"><requiredInput href="#in_partial_fund_line"/></informationRequirement>
    <informationRequirement id="ir_fund_fund"><requiredInput href="#in_partial_fund_fund"/></informationRequirement>
    <informationRequirement id="ir_fund_ppp"><requiredInput href="#in_partial_fund_ppp"/></informationRequirement>
    <decisionTable id="dt_fund" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_fund_primary" label="primary option (coding.fund)"><inputExpression id="ie_fund_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_fund_un" label="partial score for un (0-5)"><inputExpression id="ie_fund_un" typeRef="number"><text>partial_fund_un</text></inputExpression></input>
      <input id="i_fund_line" label="partial score for line (0-5)"><inputExpression id="ie_fund_line" typeRef="number"><text>partial_fund_line</text></inputExpression></input>
      <input id="i_fund_fund" label="partial score for fund (0-5)"><inputExpression id="ie_fund_fund" typeRef="number"><text>partial_fund_fund</text></inputExpression></input>
      <input id="i_fund_ppp" label="partial score for ppp (0-5)"><inputExpression id="ie_fund_ppp" typeRef="number"><text>partial_fund_ppp</text></inputExpression></input>
      <output id="o_fund" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_fund_un_primary"><description>unfunded: primary</description><inputEntry id="rfund_un_p_0"><text>"un"</text></inputEntry><inputEntry id="rfund_un_p_1"><text>-</text></inputEntry><inputEntry id="rfund_un_p_2"><text>-</text></inputEntry><inputEntry id="rfund_un_p_3"><text>-</text></inputEntry><inputEntry id="rfund_un_p_4"><text>-</text></inputEntry><outputEntry id="oe_fund_un_p"><text>0</text></outputEntry></rule>
      <rule id="rule_fund_un_partial"><description>unfunded: partial</description><inputEntry id="rfund_un_s_0"><text>-</text></inputEntry><inputEntry id="rfund_un_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="rfund_un_s_2"><text>-</text></inputEntry><inputEntry id="rfund_un_s_3"><text>-</text></inputEntry><inputEntry id="rfund_un_s_4"><text>-</text></inputEntry><outputEntry id="oe_fund_un_s"><text>0 * partial_fund_un / 5</text></outputEntry></rule>
      <rule id="rule_fund_line_primary"><description>earmarked budget line: primary</description><inputEntry id="rfund_line_p_0"><text>"line"</text></inputEntry><inputEntry id="rfund_line_p_1"><text>-</text></inputEntry><inputEntry id="rfund_line_p_2"><text>-</text></inputEntry><inputEntry id="rfund_line_p_3"><text>-</text></inputEntry><inputEntry id="rfund_line_p_4"><text>-</text></inputEntry><outputEntry id="oe_fund_line_p"><text>3</text></outputEntry></rule>
      <rule id="rule_fund_line_partial"><description>earmarked budget line: partial</description><inputEntry id="rfund_line_s_0"><text>-</text></inputEntry><inputEntry id="rfund_line_s_1"><text>-</text></inputEntry><inputEntry id="rfund_line_s_2"><text>&gt; 0</text></inputEntry><inputEntry id="rfund_line_s_3"><text>-</text></inputEntry><inputEntry id="rfund_line_s_4"><text>-</text></inputEntry><outputEntry id="oe_fund_line_s"><text>3 * partial_fund_line / 5</text></outputEntry></rule>
      <rule id="rule_fund_fund_primary"><description>dedicated fund: primary</description><inputEntry id="rfund_fund_p_0"><text>"fund"</text></inputEntry><inputEntry id="rfund_fund_p_1"><text>-</text></inputEntry><inputEntry id="rfund_fund_p_2"><text>-</text></inputEntry><inputEntry id="rfund_fund_p_3"><text>-</text></inputEntry><inputEntry id="rfund_fund_p_4"><text>-</text></inputEntry><outputEntry id="oe_fund_fund_p"><text>5</text></outputEntry></rule>
