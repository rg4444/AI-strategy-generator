      <rule id="rule_access_targeted_primary"><description>free access for target groups: primary</description><inputEntry id="raccess_targeted_p_0"><text>"targeted"</text></inputEntry><inputEntry id="raccess_targeted_p_1"><text>-</text></inputEntry><inputEntry id="raccess_targeted_p_2"><text>-</text></inputEntry><inputEntry id="raccess_targeted_p_3"><text>-</text></inputEntry><inputEntry id="raccess_targeted_p_4"><text>-</text></inputEntry><inputEntry id="raccess_targeted_p_5"><text>-</text></inputEntry><inputEntry id="raccess_targeted_p_6"><text>-</text></inputEntry><outputEntry id="oe_access_targeted_p"><text>4</text></outputEntry></rule>
