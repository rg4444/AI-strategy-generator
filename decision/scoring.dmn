  </decision>
  <decision id="score_identity" name="Axis score: AI identity provision">
    <description>How far the state has got with identity for AI agents — who the agent is, who owns it, what it may do. None 0; policy talk only 1; person e-identity exists but nothing for agents 2; agent identity pilot 3; national agent identity 4; cross-border verification gateway 5.</description>
    <informationRequirement id="ir_identity_p"><requiredInput href="#in_primary"/></informationRequirement>
    <informationRequirement id="ir_identity_none"><requiredInput href="#in_partial_identity_none"/></informationRequirement>
    <informationRequirement id="ir_identity_policy"><requiredInput href="#in_partial_identity_policy"/></informationRequirement>
    <informationRequirement id="ir_identity_pid"><requiredInput href="#in_partial_identity_pid"/></informationRequirement>
    <informationRequirement id="ir_identity_pilot"><requiredInput href="#in_partial_identity_pilot"/></informationRequirement>
    <informationRequirement id="ir_identity_natid"><requiredInput href="#in_partial_identity_natid"/></informationRequirement>
    <informationRequirement id="ir_identity_gw"><requiredInput href="#in_partial_identity_gw"/></informationRequirement>
    <decisionTable id="dt_identity" hitPolicy="COLLECT" aggregation="MAX">
      <input id="i_identity_primary" label="primary option (coding.identity)"><inputExpression id="ie_identity_p" typeRef="string"><text>primary</text></inputExpression></input>
      <input id="i_identity_none" label="partial score for none (0-5)"><inputExpression id="ie_identity_none" typeRef="number"><text>partial_identity_none</text></inputExpression></input>
      <input id="i_identity_policy" label="partial score for policy (0-5)"><inputExpression id="ie_identity_policy" typeRef="number"><text>partial_identity_policy</text></inputExpression></input>
      <input id="i_identity_pid" label="partial score for pid (0-5)"><inputExpression id="ie_identity_pid" typeRef="number"><text>partial_identity_pid</text></inputExpression></input>
      <input id="i_identity_pilot" label="partial score for pilot (0-5)"><inputExpression id="ie_identity_pilot" typeRef="number"><text>partial_identity_pilot</text></inputExpression></input>
      <input id="i_identity_natid" label="partial score for natid (0-5)"><inputExpression id="ie_identity_natid" typeRef="number"><text>partial_identity_natid</text></inputExpression></input>
      <input id="i_identity_gw" label="partial score for gw (0-5)"><inputExpression id="ie_identity_gw" typeRef="number"><text>partial_identity_gw</text></inputExpression></input>
      <output id="o_identity" label="axis score (0-5)" name="score" typeRef="number"/>
      <rule id="rule_identity_none_primary"><description>none: primary</description><inputEntry id="ridentity_none_p_0"><text>"none"</text></inputEntry><inputEntry id="ridentity_none_p_1"><text>-</text></inputEntry><inputEntry id="ridentity_none_p_2"><text>-</text></inputEntry><inputEntry id="ridentity_none_p_3"><text>-</text></inputEntry><inputEntry id="ridentity_none_p_4"><text>-</text></inputEntry><inputEntry id="ridentity_none_p_5"><text>-</text></inputEntry><inputEntry id="ridentity_none_p_6"><text>-</text></inputEntry><outputEntry id="oe_identity_none_p"><text>0</text></outputEntry></rule>
      <rule id="rule_identity_none_partial"><description>none: partial</description><inputEntry id="ridentity_none_s_0"><text>-</text></inputEntry><inputEntry id="ridentity_none_s_1"><text>&gt; 0</text></inputEntry><inputEntry id="ridentity_none_s_2"><text>-</text></inputEntry><inputEntry id="ridentity_none_s_3"><text>-</text></inputEntry><inputEntry id="ridentity_none_s_4"><text>-</text></inputEntry><inputEntry id="ridentity_none_s_5"><text>-</text></inputEntry><inputEntry id="ridentity_none_s_6"><text>-</text></inputEntry><outputEntry id="oe_identity_none_s"><text>0 * partial_identity_none / 5</text></outputEntry></rule>
      <rule id="rule_identity_policy_primary"><description>policy discussion only: primary</description><inputEntry id="ridentity_policy_p_0"><text>"policy"</text></inputEntry><inputEntry id="ridentity_policy_p_1"><text>-</text></inputEntry><inputEntry id="ridentity_policy_p_2"><text>-</text></inputEntry><inputEntry id="ridentity_policy_p_3"><text>-</text></inputEntry><inputEntry id="ridentity_policy_p_4"><text>-</text></inputEntry><inputEntry id="ridentity_policy_p_5"><text>-</text></inputEntry><inputEntry id="ridentity_policy_p_6"><text>-</text></inputEntry><outputEntry id="oe_identity_policy_p"><text>1</text></outputEntry></rule>
      <rule id="rule_identity_policy_partial"><description>policy discussion only: partial</description><inputEntry id="ridentity_policy_s_0"><text>-</text></inputEntry><inputEntry id="ridentity_policy_s_1"><text>-</text></inputEntry><inputEntry id="ridentity_policy_s_2"><text>&gt; 0</text></inputEntry><inputEntry id="ridentity_policy_s_3"><text>-</text></inputEntry><inputEntry id="ridentity_policy_s_4"><text>-</text></inputEntry><inputEntry id="ridentity_policy_s_5"><text>-</text></inputEntry><inputEntry id="ridentity_policy_s_6"><text>-</text></inputEntry><outputEntry id="oe_identity_policy_s"><text>1 * partial_identity_policy / 5</text></outputEntry></rule>
      <rule id="rule_identity_pid_primary"><description>person e-identity, nothing for agents: primary</description><inputEntry id="ridentity_pid_p_0"><text>"pid"</text></inputEntry><inputEntry id="ridentity_pid_p_1"><text>-</text></inputEntry><inputEntry id="ridentity_pid_p_2"><text>-</text></inputEntry><inputEntry id="ridentity_pid_p_3"><text>-</text></inputEntry><inputEntry id="ridentity_pid_p_4"><text>-</text></inputEntry><inputEntry id="ridentity_pid_p_5"><text>-</text></inputEntry><inputEntry id="ridentity_pid_p_6"><text>-</text></inputEntry><outputEntry id="oe_identity_pid_p"><text>2</text></outputEntry></rule>
      <rule id="rule_identity_pid_partial"><description>person e-identity, nothing for agents: partial</description><inputEntry id="ridentity_pid_s_0"><text>-</text></inputEntry><inputEntry id="ridentity_pid_s_1"><text>-</text></inputEntry><inputEntry id="ridentity_pid_s_2"><text>-</text></inputEntry><inputEntry id="ridentity_pid_s_3"><text>&gt; 0</text></inputEntry><inputEntry id="ridentity_pid_s_4"><text>-</text></inputEntry><inputEntry id="ridentity_pid_s_5"><text>-</text></inputEntry><inputEntry id="ridentity_pid_s_6"><text>-</text></inputEntry><outputEntry id="oe_identity_pid_s"><text>2 * partial_identity_pid / 5</text></outputEntry></rule>
      <rule id="rule_identity_pilot_primary"><description>agent identity pilot: primary</description><inputEntry id="ridentity_pilot_p_0"><text>"pilot"</text></inputEntry><inputEntry id="ridentity_pilot_p_1"><text>-</text></inputEntry><inputEntry id="ridentity_pilot_p_2"><text>-</text></inputEntry><inputEntry id="ridentity_pilot_p_3"><text>-</text></inputEntry><inputEntry id="ridentity_pilot_p_4"><text>-</text></inputEntry><inputEntry id="ridentity_pilot_p_5"><text>-</text></inputEntry><inputEntry id="ridentity_pilot_p_6"><text>-</text></inputEntry><outputEntry id="oe_identity_pilot_p"><text>3</text></outputEntry></rule>
      <rule id="rule_identity_pilot_partial"><description>agent identity pilot: partial</description><inputEntry id="ridentity_pilot_s_0"><text>-</text></inputEntry><inputEntry id="ridentity_pilot_s_1"><text>-</text></inputEntry><inputEntry id="ridentity_pilot_s_2"><text>-</text></inputEntry><inputEntry id="ridentity_pilot_s_3"><text>-</text></inputEntry><inputEntry id="ridentity_pilot_s_4"><text>&gt; 0</text></inputEntry><inputEntry id="ridentity_pilot_s_5"><text>-</text></inputEntry><inputEntry id="ridentity_pilot_s_6"><text>-</text></inputEntry><outputEntry id="oe_identity_pilot_s"><text>3 * partial_identity_pilot / 5</text></outputEntry></rule>
      <rule id="rule_identity_natid_primary"><description>national AI agent identity: primary</description><inputEntry id="ridentity_natid_p_0"><text>"natid"</text></inputEntry><inputEntry id="ridentity_natid_p_1"><text>-</text></inputEntry><inputEntry id="ridentity_natid_p_2"><text>-</text></inputEntry><inputEntry id="ridentity_natid_p_3"><text>-</text></inputEntry><inputEntry id="ridentity_natid_p_4"><text>-</text></inputEntry><inputEntry id="ridentity_natid_p_5"><text>-</text></inputEntry><inputEntry id="ridentity_natid_p_6"><text>-</text></inputEntry><outputEntry id="oe_identity_natid_p"><text>4</text></outputEntry></rule>
      <rule id="rule_identity_natid_partial"><description>national AI agent identity: partial</description><inputEntry id="ridentity_natid_s_0"><text>-</text></inputEntry><inputEntry id="ridentity_natid_s_1"><text>-</text></inputEntry><inputEntry id="ridentity_natid_s_2"><text>-</text></inputEntry><inputEntry id="ridentity_natid_s_3"><text>-</text></inputEntry><inputEntry id="ridentity_natid_s_4"><text>-</text></inputEntry><inputEntry id="ridentity_natid_s_5"><text>&gt; 0</text></inputEntry><inputEntry id="ridentity_natid_s_6"><text>-</text></inputEntry><outputEntry id="oe_identity_natid_s"><text>4 * partial_identity_natid / 5</text></outputEntry></rule>
