{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rg4444/AI-strategy-generator/main/schema/ai-strategy.schema.json",
  "title": "AI strategy document (JSON form of urn:pppa:ai-strategy:1.0)",
  "description": "GENERATED from schema/ai-strategy.xsd by tools/xsd_to_jsonschema.py — do not edit.",
  "$ref": "#/$defs/AIStrategyType",
  "$defs": {
    "AIStrategyType": {
      "type": "object",
      "properties": {
        "subject": {
          "$ref": "#/$defs/SubjectType"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceType"
          }
        },
        "text": {
          "$ref": "#/$defs/TextLayerType"
        },
        "coding": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AxisCodingType"
          },
          "minItems": 1
        },
        "weights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WeightEntryType"
          }
        },
        "score": {
          "$ref": "#/$defs/ScoreType"
        },
        "narratives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NarrativeType"
          }
        },
        "id": {
          "type": "string"
        },
        "schemaVersion": {
          "$ref": "#/$defs/SchemaVersionType"
        },
        "kind": {
          "$ref": "#/$defs/KindType"
        },
        "status": {
          "$ref": "#/$defs/StatusType",
          "default": "draft"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "axesVersion": {
          "type": "string"
        },
        "axesSource": {
          "type": "string",
          "format": "uri"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "subject",
        "text",
        "coding",
        "id",
        "schemaVersion",
        "kind",
        "axesVersion"
      ]
    },
    "SubjectType": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/TextType"
        },
        "identifier": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "kind": {
              "$ref": "#/$defs/IdentifierKindType"
            }
          },
          "required": [
            "value",
            "kind"
          ],
          "additionalProperties": false
        },
        "country": {
          "type": "string"
        },
        "sector": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "TextType": {
      "type": "object",
      "patternProperties": {
        "^[a-z]{2}$": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Bilingual (or multilingual) text: one entry per language."
    },
    "IdentifierKindType": {
      "type": "string",
      "enum": [
        "country",
        "registration",
        "lei",
        "did",
        "other"
      ]
    },
    "SourceType": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "year": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "TextLayerType": {
      "type": "object",
      "properties": {
        "interest": {
          "type": "object",
          "properties": {
            "text": {
              "$ref": "#/$defs/TextType"
            },
            "source": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/InterestStatusType"
            }
          },
          "additionalProperties": false,
          "required": [
            "text",
            "status"
          ]
        },
        "vision": {
          "type": "object",
          "properties": {
            "quote": {
              "type": "string"
            },
            "note": {
              "$ref": "#/$defs/TextType"
            }
          },
          "additionalProperties": false
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectiveType"
          }
        },
        "position": {
          "$ref": "#/$defs/TextType"
        }
      },
      "additionalProperties": false,
      "required": [
        "interest",
        "vision",
        "objectives",
        "position"
      ],
      "description": "What the document itself says, recorded before any axis is coded."
    },
    "InterestStatusType": {
      "type": "string",
      "enum": [
        "yes",
        "part",
        "no"
      ],
      "description": "Does the document state why it exists?"
    },
    "ObjectiveType": {
      "type": "object",
      "properties": {
        "numbered": {
          "type": "boolean",
          "default": false
        }
      },
      "patternProperties": {
        "^[a-z]{2}$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AxisCodingType": {
      "type": "object",
      "properties": {
        "partials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartialType"
          }
        },
        "rationale": {
          "$ref": "#/$defs/TextType"
        },
        "axis": {
          "$ref": "#/$defs/KeyType"
        },
        "option": {
          "$ref": "#/$defs/KeyType"
        },
        "lowConfidence": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "axis"
      ],
      "description": "One decision. No @option means the document decides nothing on this axis (scores 0)."
    },
    "PartialType": {
      "type": "object",
      "properties": {
        "option": {
          "$ref": "#/$defs/KeyType"
        },
        "score": {
          "$ref": "#/$defs/PartialScoreType"
        }
      },
      "additionalProperties": false,
      "required": [
        "option",
        "score"
      ]
    },
    "KeyType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "Axis or option key as defined in data/axes.yaml."
    },
    "PartialScoreType": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Secondary lean, 1–4. The primary option is always 5."
    },
    "WeightEntryType": {
      "type": "object",
      "properties": {
        "axis": {
          "$ref": "#/$defs/KeyType"
        },
        "weight": {
          "$ref": "#/$defs/WeightType"
        }
      },
      "additionalProperties": false,
      "required": [
        "axis",
        "weight"
      ]
    },
    "WeightType": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Percent points; weights need not sum to 100."
    },
    "ScoreType": {
      "type": "object",
      "properties": {
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AxisScoreType"
          }
        },
        "overall": {
          "$ref": "#/$defs/Score05Type"
        },
        "scoringVersion": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Computed by decision/scoring.dmn (or tools/score.py); never authored by hand."
    },
    "AxisScoreType": {
      "type": "object",
      "properties": {
        "axis": {
          "$ref": "#/$defs/KeyType"
        },
        "value": {
          "$ref": "#/$defs/Score05Type"
        }
      },
      "additionalProperties": false,
      "required": [
        "axis",
        "value"
      ]
    },
    "Score05Type": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 5.0
    },
    "NarrativeType": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NarrativeSectionType"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lang": {
          "$ref": "#/$defs/LangType"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "model": {
          "type": "string"
        },
        "docVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "lang"
      ],
      "description": "Readable strategy text generated from the configuration (a language model writes it; the configuration stays the source). One per language."
    },
    "NarrativeSectionType": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "heading"
      ]
    },
    "LangType": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "SchemaVersionType": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "KindType": {
      "type": "string",
      "enum": [
        "national",
        "organisation"
      ],
      "description": "Who the strategy is for. The axes are identical; only the reading of three of them changes."
    },
    "StatusType": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "final",
        "superseded"
      ]
    }
  }
}
